# ==============================================================================
# Is It Special? — Environment Configuration Template
# Copy this file to `.env` or set these in your GitHub Actions Secrets / Hosting
# ==============================================================================

# Google Search Console Verification Meta Tag Value
# (Copy only the 'content' string from your HTML tag verification method in GSC)
PUBLIC_GSC_VERIFICATION=

# Google Analytics 4 Measurement ID (Format: G-XXXXXXXXXX)
PUBLIC_GA_ID=

# Cloudflare Turnstile Anti-Spam Site Key
# (Leave empty to use Cloudflare's always-pass test key in development)
PUBLIC_TURNSTILE_SITE_KEY=

# Amazon Associates Tracking ID
PUBLIC_AMAZON_STORE_ID=isitspecial-21
