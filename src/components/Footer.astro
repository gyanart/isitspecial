---
interface Props {
  lang?: 'en' | 'hi';
}

const { lang = 'en' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[#dce5dd]/80 bg-[#f7faf7] text-[#14241c]/70 mt-20 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col items-center text-center space-y-8">
    
    <!-- Grasshopper Brand Logo Centerpiece -->
    <a href={lang === 'hi' ? '/hi' : '/'} class="inline-flex items-center space-x-2.5 text-[#14241c] group">
      <span class="w-8 h-8 rounded-full bg-[#15803d] text-white flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform">
        <svg class="h-4 w-4 text-white" fill="none" stroke="currentColor" stroke-width="2.3" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        </svg>
      </span>
      <span class="font-serif text-2xl font-black italic tracking-tight text-[#14241c]">
        Is It Special<span class="text-[#15803d]">?</span>
      </span>
    </a>

    <!-- Mission Tagline -->
    <p class="max-w-md text-xs sm:text-sm text-[#14241c]/65 leading-relaxed font-normal">
      {lang === 'hi' 
        ? 'वायरल मार्केटिंग और सतही ट्रेंड्स के खिलाफ एक निष्पक्ष, स्वतंत्र समीक्षा कैटालॉग। सभी परीक्षण बिना किसी प्रायोजन के किए जाते हैं।'
        : 'An unfiltered consumer critique catalog with unvarnished verdicts and zero sponsor influence. Real objects tested with confidence.'
      }
    </p>

    <!-- Compact Footer Substack Newsletter Subscription -->
    <div class="w-full max-w-md mx-auto">
      <form 
        action="https://isitspecial.substack.com/api/v1/free?nojs=true" 
        method="post" 
        target="_blank"
        class="flex items-center gap-2"
      >
        <input 
          type="email" 
          name="email" 
          required 
          placeholder={lang === 'hi' ? 'ईमेल द्वारा साप्ताहिक अपडेट्स पाएं...' : 'Get weekly teardowns in your inbox...'} 
          class="w-full px-4 py-2.5 rounded-full border border-[#dce5dd] text-xs bg-white text-[#14241c] placeholder-[#14241c]/45 focus:outline-none focus:border-[#15803d] focus:ring-2 focus:ring-[#15803d]/20 transition-all shadow-2xs"
        />
        <button 
          type="submit" 
          class="shrink-0 px-5 py-2.5 rounded-full bg-[#15803d] hover:bg-[#166534] text-white text-xs font-bold uppercase tracking-wider transition-all duration-200 cursor-pointer shadow-xs hover:shadow-md active:scale-95"
        >
          {lang === 'hi' ? 'ज्वाइन' : 'Join'}
        </button>
      </form>
    </div>

    <!-- Navigation & AdSense Mandatory Compliance Links (Pill Style) -->
    <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2.5 text-xs font-medium text-[#14241c]/75">
      <a href={lang === 'hi' ? '/hi' : '/'} class="hover:text-[#15803d] transition-colors">{lang === 'hi' ? 'होम' : 'Home'}</a>
      <a href={lang === 'hi' ? '/hi#categories' : '/#categories'} class="hover:text-[#15803d] transition-colors">{lang === 'hi' ? 'कैटालॉग' : 'The Catalog'}</a>
      <a href="/about" class="hover:text-[#15803d] transition-colors">{lang === 'hi' ? 'परीक्षण मानक' : 'Our Criteria'}</a>
      <a href="/contact" class="hover:text-[#15803d] transition-colors">{lang === 'hi' ? 'सुझाव भेजें' : 'Submit an Item'}</a>
      <span class="text-[#dce5dd] hidden sm:inline">&bull;</span>
      <a href="/privacy-policy" class="hover:text-[#15803d] transition-colors">{lang === 'hi' ? 'गोपनीयता नीति' : 'Privacy Policy'}</a>
      <a href="/terms" class="hover:text-[#15803d] transition-colors">{lang === 'hi' ? 'नियम व शर्तें' : 'Terms of Service'}</a>
      <a href={lang === 'hi' ? '/hi/affiliate-disclosure' : '/affiliate-disclosure'} class="hover:text-[#15803d] transition-colors">{lang === 'hi' ? 'एफिलिएट प्रकटीकरण' : 'Affiliate Disclosure'}</a>
    </nav>

    <!-- Bottom Copyright & Amazon Disclosure -->
    <div class="pt-6 border-t border-[#dce5dd]/60 w-full flex flex-col items-center text-[11px] text-[#14241c]/50 gap-2">
      <p class="text-[11.5px] text-[#14241c]/60 max-w-xl mx-auto">
        {lang === 'hi' 
          ? 'एक अमेज़न एसोसिएट के रूप में, isitspecial.com योग्य खरीदारियों से कमीशन अर्जित करता है।' 
          : 'As an Amazon Associate, isitspecial.com earns from qualifying purchases.'}
      </p>
      <div class="w-full flex flex-col sm:flex-row justify-between items-center pt-2 text-[11px] text-[#14241c]/45 gap-2">
        <p>&copy; {currentYear} isitspecial.com. All rights reserved.</p>
        <p>
          {lang === 'hi' ? 'वेबसाइट डिज़ाइन:' : 'Website Design by'} <a href="https://www.gyanart.com" target="_blank" rel="noopener noreferrer" class="font-semibold text-[#14241c]/70 hover:text-[#15803d] transition-colors underline decoration-[#dce5dd] underline-offset-2">GyanArt</a>
        </p>
      </div>
    </div>

  </div>
</footer>
