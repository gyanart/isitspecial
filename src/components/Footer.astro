---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-stone-200 bg-stone-100 text-stone-600 mt-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Brand & Mission -->
      <div class="md:col-span-2 space-y-3">
        <h3 class="font-serif text-lg font-bold text-stone-900 tracking-tight">IS IT SPECIAL?</h3>
        <p class="text-sm text-stone-600 leading-relaxed max-w-sm">
          A dedicated filter against viral consumer hype, deceptive influencer marketing, and disposable trends. We test, examine, and answer the one question that matters: is it truly special?
        </p>
        <p class="text-xs text-stone-600">
          Editorial independence is our core rule. All assessments are conducted without corporate sponsorship.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold text-stone-900 uppercase tracking-wider">Navigation</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-stone-900 transition-colors">Latest Articles</a></li>
          <li><a href="/about" class="hover:text-stone-900 transition-colors">About Our Criteria</a></li>
          <li><a href="/contact" class="hover:text-stone-900 transition-colors">Submit an Item to Test</a></li>
        </ul>
      </div>

      <!-- Mandatory Legal Compliance for AdSense -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold text-stone-900 uppercase tracking-wider">Legal & Transparency</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/privacy-policy" class="hover:text-stone-900 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-stone-900 transition-colors">Terms of Service</a></li>
          <li><a href="/terms#disclaimer" class="hover:text-stone-900 transition-colors">Editorial & Affiliate Disclaimer</a></li>
          <li><a href="/contact" class="hover:text-stone-900 transition-colors">Contact Editorial Office</a></li>
        </ul>
      </div>

    </div>

    <div class="mt-12 pt-6 border-t border-stone-200 flex flex-col sm:flex-row justify-between items-center text-xs text-stone-600 space-y-4 sm:space-y-0">
      <p>&copy; {currentYear} isitspecial.com. All rights reserved.</p>
      <p>Built for zero bloat, high performance, and honest criticism.</p>
    </div>
  </div>
</footer>
