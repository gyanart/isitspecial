---
interface Props {
  score: number;
  verdict: 'Overhyped' | 'Solid Standard' | 'True Gem' | 'Modern Masterpiece';
  summary: string;
  pros?: string[];
  cons?: string[];
  whoShouldBuy?: string;
  whoShouldSkip?: string;
}

const { 
  score, 
  verdict, 
  summary, 
  pros = [], 
  cons = [], 
  whoShouldBuy, 
  whoShouldSkip 
} = Astro.props;

// Color styling based on verdict
const verdictConfig = {
  'Overhyped': {
    badgeBg: 'bg-rose-100 text-rose-800 border-rose-200',
    scoreColor: 'text-rose-600',
    border: 'border-rose-200'
  },
  'Solid Standard': {
    badgeBg: 'bg-amber-100 text-amber-800 border-amber-200',
    scoreColor: 'text-amber-600',
    border: 'border-amber-200'
  },
  'True Gem': {
    badgeBg: 'bg-emerald-100 text-emerald-800 border-emerald-200',
    scoreColor: 'text-emerald-700',
    border: 'border-emerald-200'
  },
  'Modern Masterpiece': {
    badgeBg: 'bg-indigo-100 text-indigo-800 border-indigo-200',
    scoreColor: 'text-indigo-700',
    border: 'border-indigo-200'
  }
};

const currentTheme = verdictConfig[verdict] || verdictConfig['Solid Standard'];
---

<div class={`my-10 rounded-2xl border-2 ${currentTheme.border} bg-white p-6 sm:p-8 shadow-sm transition-all`}>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-6 border-b border-stone-200 gap-4">
    <div>
      <span class="text-xs font-bold uppercase tracking-widest text-stone-600">The Special Index Verdict</span>
      <h3 class="font-serif text-2xl font-bold text-stone-900 mt-1">Is It Special?</h3>
    </div>

    <div class="flex items-center space-x-4">
      <span class={`px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider border ${currentTheme.badgeBg}`}>
        {verdict}
      </span>
      <div class="flex items-baseline space-x-1">
        <span class={`text-4xl font-black font-serif tracking-tight ${currentTheme.scoreColor}`}>{score.toFixed(1)}</span>
        <span class="text-xs font-bold text-stone-600 uppercase">/ 10</span>
      </div>
    </div>
  </div>

  <p class="mt-5 text-stone-700 text-base leading-relaxed italic">
    "{summary}"
  </p>

  {(pros.length > 0 || cons.length > 0) && (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6 pt-6 border-t border-stone-100 text-sm">
      {pros.length > 0 && (
        <div class="space-y-2">
          <h4 class="font-bold text-emerald-800 flex items-center space-x-1">
            <span>✓</span>
            <span>What Makes It Special</span>
          </h4>
          <ul class="space-y-1 text-stone-600 pl-4 list-disc">
            {pros.map(item => <li>{item}</li>)}
          </ul>
        </div>
      )}

      {cons.length > 0 && (
        <div class="space-y-2">
          <h4 class="font-bold text-rose-800 flex items-center space-x-1">
            <span>✕</span>
            <span>Where The Hype Fails</span>
          </h4>
          <ul class="space-y-1 text-stone-600 pl-4 list-disc">
            {cons.map(item => <li>{item}</li>)}
          </ul>
        </div>
      )}
    </div>
  )}

  {(whoShouldBuy || whoShouldSkip) && (
    <div class="mt-6 pt-5 border-t border-stone-100 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
      {whoShouldBuy && (
        <div class="bg-stone-50 p-3 rounded-lg border border-stone-100">
          <span class="font-bold text-stone-900 uppercase tracking-wide block mb-1">Who Should Get It:</span>
          <span class="text-stone-600">{whoShouldBuy}</span>
        </div>
      )}
      {whoShouldSkip && (
        <div class="bg-stone-50 p-3 rounded-lg border border-stone-100">
          <span class="font-bold text-stone-900 uppercase tracking-wide block mb-1">Who Should Skip:</span>
          <span class="text-stone-600">{whoShouldSkip}</span>
        </div>
      )}
    </div>
  )}
</div>
