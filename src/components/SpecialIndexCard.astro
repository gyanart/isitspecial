---
interface Props {
  score: number;
  verdict: string;
  summary: string;
  pros?: string[];
  cons?: string[];
  whoShouldBuy?: string;
  whoShouldSkip?: string;
  affiliateUrl?: string;
  affiliateLabel?: string;
  affiliateStore?: string;
  productKeyword?: string;
  isAffiliate?: boolean;
  lang?: 'en' | 'hi';
}

const { 
  score, 
  verdict, 
  summary, 
  pros = [], 
  cons = [], 
  whoShouldBuy, 
  whoShouldSkip,
  affiliateUrl,
  affiliateLabel,
  affiliateStore = 'Amazon',
  productKeyword,
  isAffiliate = true,
  lang = 'en'
} = Astro.props;

const isHi = lang === 'hi';
const isAmazon = affiliateStore.toLowerCase() === 'amazon';

// Automatic Smart Affiliate URL builder with store ID "isitspecial-21"
const defaultStoreTag = 'isitspecial-21';
const generatedUrl = productKeyword 
  ? (isHi 
      ? `https://www.amazon.in/s?k=${encodeURIComponent(productKeyword)}&tag=${defaultStoreTag}`
      : `https://www.amazon.com/s?k=${encodeURIComponent(productKeyword)}&tag=${defaultStoreTag}`)
  : undefined;

const effectiveAffiliateUrl = affiliateUrl || generatedUrl;

// Color styling based on verdict keywords
const isOverhyped = verdict.toLowerCase().includes('overhyped') || verdict.includes('ओवरहाइप्ड');
const isMasterpiece = verdict.toLowerCase().includes('masterpiece') || verdict.includes('मास्टरपीस');
const isGem = verdict.toLowerCase().includes('gem') || verdict.includes('नगीना');

const verdictTheme = isOverhyped
  ? { badge: 'bg-rose-50 text-rose-700 border-rose-200/80', score: 'text-rose-600', ring: 'ring-rose-500/10' }
  : isMasterpiece
  ? { badge: 'bg-[#eaf5eb] text-[#15803d] border-[#bbf7d0]', score: 'text-[#15803d]', ring: 'ring-[#15803d]/10' }
  : isGem
  ? { badge: 'bg-emerald-50 text-emerald-800 border-emerald-200/80', score: 'text-emerald-700', ring: 'ring-emerald-500/10' }
  : { badge: 'bg-amber-50 text-amber-800 border-amber-200/80', score: 'text-amber-700', ring: 'ring-amber-500/10' };
---

<!-- 'not-prose' prevents markdown styling from overriding button colors and text -->
<div 
  class="not-prose my-12 rounded-3xl border border-[#dce5dd]/90 bg-white p-6 sm:p-9 shadow-sm special-card"
  data-special-card="true"
  data-lang={lang}
>
  
  <!-- Header: Title and Big Score Counter -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-6 border-b border-[#dce5dd]/60 gap-4">
    <div>
      <div class="flex items-center space-x-2">
        <span class="inline-block w-2 h-2 rounded-full bg-[#15803d] animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-[#14241c]/60 font-mono">
          {isHi ? 'द स्पेशल इंडेक्स निष्कर्ष' : 'The Special Index Verdict'}
        </span>
      </div>
      <h3 class="font-serif text-2xl sm:text-3xl font-extrabold text-[#14241c] mt-1">
        {isHi ? 'क्या यह वाकई खास है?' : 'Is It Special?'}
      </h3>
    </div>

    <!-- Rating Score Box -->
    <div class="flex items-center space-x-4 self-start sm:self-auto bg-[#f7faf7] px-4 py-2.5 rounded-2xl border border-[#dce5dd]/80">
      <div class="text-right">
        <span class={`inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider border ${verdictTheme.badge}`}>
          {verdict}
        </span>
      </div>
      <div class="border-l border-[#dce5dd] pl-4 flex items-baseline space-x-1">
        <span class={`text-4xl sm:text-5xl font-black font-serif tracking-tight ${verdictTheme.score}`}>
          {score.toFixed(1)}
        </span>
        <span class="text-xs font-bold text-[#14241c]/60 uppercase font-mono">/10</span>
      </div>
    </div>
  </div>

  <!-- Summary Quote -->
  <div class="my-6 p-4 sm:p-5 rounded-2xl bg-[#f7faf7] border-l-4 border-[#15803d] text-[#14241c]/85 text-base sm:text-lg leading-relaxed italic">
    "{summary}"
  </div>

  <!-- Pros & Cons Grid -->
  {(pros.length > 0 || cons.length > 0) && (
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-6 pt-2 text-sm">
      {pros.length > 0 && (
        <div class="p-4 rounded-2xl bg-emerald-50/50 border border-emerald-100/80 space-y-2.5">
          <h4 class="font-bold text-emerald-900 flex items-center space-x-1.5 text-xs uppercase tracking-wider">
            <span class="w-4 h-4 rounded-full bg-emerald-600 text-white flex items-center justify-center text-[10px]">✓</span>
            <span>{isHi ? 'क्या इसे खास बनाता है' : 'What Makes It Special'}</span>
          </h4>
          <ul class="space-y-1.5 text-zinc-700 pl-2">
            {pros.map(item => (
              <li class="flex items-start space-x-2">
                <span class="text-emerald-600 font-bold leading-none">&bull;</span>
                <span class="leading-snug">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {cons.length > 0 && (
        <div class="p-4 rounded-2xl bg-rose-50/50 border border-rose-100/80 space-y-2.5">
          <h4 class="font-bold text-rose-900 flex items-center space-x-1.5 text-xs uppercase tracking-wider">
            <span class="w-4 h-4 rounded-full bg-rose-600 text-white flex items-center justify-center text-[10px]">✕</span>
            <span>{isHi ? 'कहाँ हाइप फेल होती है' : 'Where The Hype Fails'}</span>
          </h4>
          <ul class="space-y-1.5 text-zinc-700 pl-2">
            {cons.map(item => (
              <li class="flex items-start space-x-2">
                <span class="text-rose-600 font-bold leading-none">&bull;</span>
                <span class="leading-snug">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )}

  <!-- Persona Recommendation -->
  {(whoShouldBuy || whoShouldSkip) && (
    <div class="mt-6 pt-5 border-t border-zinc-100 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
      {whoShouldBuy && (
        <div class="bg-zinc-50 p-3.5 rounded-xl border border-zinc-200/60">
          <span class="font-bold text-zinc-900 uppercase tracking-wide block mb-1">
            {isHi ? 'किसे खरीदना चाहिए:' : 'Who Should Get It:'}
          </span>
          <span class="text-zinc-600 leading-relaxed block">{whoShouldBuy}</span>
        </div>
      )}
      {whoShouldSkip && (
        <div class="bg-zinc-50 p-3.5 rounded-xl border border-zinc-200/60">
          <span class="font-bold text-zinc-900 uppercase tracking-wide block mb-1">
            {isHi ? 'किसे छोड़ देना चाहिए:' : 'Who Should Skip:'}
          </span>
          <span class="text-zinc-600 leading-relaxed block">{whoShouldSkip}</span>
        </div>
      )}
    </div>
  )}

  <!-- Modern High-Contrast Affiliate Callout with Crisp Vector SVG Icons -->
  {effectiveAffiliateUrl && (
    <div class="mt-7 pt-6 border-t border-zinc-200/90 flex flex-col sm:flex-row items-center justify-between gap-5 bg-zinc-950 text-white p-5 sm:p-6 rounded-2xl shadow-lg">
      
      <!-- Left Info: Store Vector Logo + Title -->
      <div class="text-xs space-y-1.5 text-center sm:text-left flex-1 min-w-0">
        <div class="flex items-center justify-center sm:justify-start space-x-2.5">
          {affiliateStore.toLowerCase() === 'amazon' ? (
            <div class="px-2.5 py-1 rounded-lg bg-zinc-900 border border-zinc-800 inline-flex items-center space-x-1.5 shadow-inner">
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 448 512" fill="none">
                <path fill="#ffffff" d="M257.2 162.7c-48.7 1.8-169.5 15.5-169.5 117.5c0 109.5 138.3 114 183.5 43.2c6.5 10.2 35.4 37.5 45.3 46.8l56.8-56S341 288.9 341 261.4V114.3C341 89 316.5 32 228.7 32C140.7 32 94 87 94 136.3l73.5 6.8c16.3-49.5 54.2-49.5 54.2-49.5c40.7-.1 35.5 29.8 35.5 69.1m0 86.8c0 80-84.2 68-84.2 17.2c0-47.2 50.5-56.7 84.2-57.8z"/>
                <path fill="#FF9900" d="M393.2 413c-7.7 10-70 67-174.5 67S34.2 408.5 9.7 379c-6.8-7.7 1-11.3 5.5-8.3C88.5 415.2 203 488.5 387.7 401c7.5-3.7 13.3 2 5.5 12z"/>
                <path fill="#FF9900" d="M433 415.2c-6.5 15.8-16 26.8-21.2 31c-5.5 4.5-9.5 2.7-6.5-3.8s19.3-46.5 12.7-55c-6.5-8.3-37-4.3-48-3.2c-10.8 1-13 2-14-.3c-2.3-5.7 21.7-15.5 37.5-17.5c15.7-1.8 41-.8 46 5.7c3.7 5.1 0 27.1-6.5 43.1z"/>
              </svg>
              <span class="font-extrabold tracking-wide text-xs text-white">
                amazon<span class="text-amber-400 font-bold" data-amazon-tld>{isHi ? '.in' : ''}</span>
              </span>
            </div>
          ) : (
            <div class="px-2.5 py-1 rounded-lg bg-zinc-900 border border-zinc-800 inline-flex items-center space-x-1.5 shadow-inner">
              <svg class="h-3.5 w-3.5 text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
              </svg>
              <span class="font-extrabold tracking-wide text-xs text-white">
                {affiliateStore}
              </span>
            </div>
          )}

          <span class="font-bold text-sm text-zinc-100">
            {isHi ? 'मूल्य एवं उपलब्धता जांचें' : 'Check Real-Time Pricing & Stock'}
          </span>
        </div>

        <p class="text-[11px] text-zinc-400 leading-relaxed max-w-md">
          {isAffiliate 
            ? (isHi 
                ? '*पारदर्शिता: यदि आप हमारे लिंक से खरीदते हैं, तो हमें बिना किसी अतिरिक्त शुल्क के एक छोटा कमीशन मिल सकता है।' 
                : '*Transparency: As an independent reviewer, we may earn a small referral commission at zero extra cost to you.')
            : (isHi 
                ? '*पारदर्शिता: यह गैर-संबद्ध सीधा लिंक है जो केवल पाठकों की सुविधा के लिए दिया गया है।' 
                : '*Transparency: Direct non-affiliate retailer link provided purely for reader convenience.')
          }
        </p>
      </div>

      <!-- High-Contrast Pure Black Text on Amber Button with Sharp Vector SVG Cart Icon -->
      <a 
        href={effectiveAffiliateUrl} 
        target="_blank" 
        rel="nofollow sponsored noopener" 
        data-amazon-geo={isAmazon && productKeyword ? "true" : undefined}
        data-keyword={productKeyword}
        data-tag={defaultStoreTag}
        data-has-custom-label={affiliateLabel ? "true" : undefined}
        class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-zinc-950 font-black text-sm transition-all duration-200 shadow-md hover:shadow-xl flex items-center justify-center space-x-2.5 shrink-0 cursor-pointer no-underline group"
        style="text-decoration: none !important; color: #09090b !important;"
      >
        <!-- Sharp Solid Black High-Visibility Shopping Cart Icon -->
        <svg class="w-5 h-5 text-zinc-950 shrink-0 group-hover:scale-110 transition-transform stroke-zinc-950 fill-none" stroke-width="2.3" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1.5" fill="#09090b"></circle>
          <circle cx="19" cy="21" r="1.5" fill="#09090b"></circle>
          <path d="M1 2h3.5l2.6 12.2a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6L22.5 7H5.5" stroke="#09090b"></path>
        </svg>

        <span data-affiliate-label class="tracking-tight font-black" style="color: #09090b !important;">
          {affiliateLabel || (isHi ? `${affiliateStore} पर देखें →` : `Check Price on ${affiliateStore} →`)}
        </span>
      </a>

    </div>
  )}

</div>

<script is:inline>
  // Automatic Universal Amazon Geo-Redirection Engine
  (function initAmazonGeoEngine() {
    try {
      var tz = '';
      try {
        tz = (Intl && Intl.DateTimeFormat) ? Intl.DateTimeFormat().resolvedOptions().timeZone || '' : '';
      } catch(e) {}
      
      var navLang = (navigator.language || '').toLowerCase();
      var languages = (navigator.languages || []).map(function(l) { return (l || '').toLowerCase(); });

      // Country TLD resolution table
      var tld = 'com';
      var storeSuffix = '';

      var isIndia = tz.indexOf('Kolkata') !== -1 || tz.indexOf('Calcutta') !== -1 || navLang.indexOf('-in') !== -1 || languages.some(function(l) { return l.indexOf('-in') !== -1 || l === 'hi'; });
      var isUK = tz.indexOf('London') !== -1 || tz.indexOf('Belfast') !== -1 || navLang === 'en-gb' || languages.some(function(l) { return l === 'en-gb'; });
      var isCanada = tz.indexOf('Toronto') !== -1 || tz.indexOf('Vancouver') !== -1 || tz.indexOf('Montreal') !== -1 || tz.indexOf('Edmonton') !== -1 || navLang === 'en-ca' || navLang === 'fr-ca';
      var isAustralia = tz.indexOf('Sydney') !== -1 || tz.indexOf('Melbourne') !== -1 || tz.indexOf('Brisbane') !== -1 || tz.indexOf('Perth') !== -1 || navLang === 'en-au';
      var isGermany = tz.indexOf('Berlin') !== -1 || tz.indexOf('Vienna') !== -1 || navLang.indexOf('de') === 0;
      var isFrance = tz.indexOf('Paris') !== -1 || navLang.indexOf('fr') === 0;
      var isJapan = tz.indexOf('Tokyo') !== -1 || navLang.indexOf('ja') === 0;

      if (isIndia) {
        tld = 'in';
        storeSuffix = '.in';
      } else if (isUK) {
        tld = 'co.uk';
        storeSuffix = '.co.uk';
      } else if (isCanada) {
        tld = 'ca';
        storeSuffix = '.ca';
      } else if (isAustralia) {
        tld = 'com.au';
        storeSuffix = '.com.au';
      } else if (isGermany) {
        tld = 'de';
        storeSuffix = '.de';
      } else if (isFrance) {
        tld = 'fr';
        storeSuffix = '.fr';
      } else if (isJapan) {
        tld = 'co.jp';
        storeSuffix = '.co.jp';
      }

      function applyGeoLinks() {
        var cards = document.querySelectorAll('[data-special-card="true"]');
        cards.forEach(function(card) {
          var btn = card.querySelector('[data-amazon-geo="true"]');
          if (!btn) return;

          var keyword = btn.getAttribute('data-keyword');
          var tag = btn.getAttribute('data-tag') || 'isitspecial-21';
          if (!keyword) return;

          // Rewrite URL to reader's localized Amazon storefront
          btn.href = 'https://www.amazon.' + tld + '/s?k=' + encodeURIComponent(keyword) + '&tag=' + tag;

          // Update visible Amazon storefront badge (e.g. amazon.in, amazon.co.uk)
          var badge = card.querySelector('[data-amazon-tld]');
          if (badge) {
            badge.textContent = storeSuffix;
          }

          // Update button text if no custom hardcoded label was assigned
          var hasCustomLabel = btn.getAttribute('data-has-custom-label') === 'true';
          var btnText = card.querySelector('[data-affiliate-label]');
          var isHindi = card.getAttribute('data-lang') === 'hi';

          if (btnText && !hasCustomLabel) {
            btnText.textContent = isHindi 
              ? 'अमेज़न (Amazon' + storeSuffix + ') पर देखें →' 
              : 'Check Price on Amazon' + storeSuffix + ' →';
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applyGeoLinks);
      } else {
        applyGeoLinks();
      }
    } catch(err) {
      console.warn('Geo link resolution fallback to defaults.', err);
    }
  })();
</script>
