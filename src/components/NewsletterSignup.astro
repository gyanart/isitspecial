---
interface Props {
  lang?: 'en' | 'hi';
}

const { lang = 'en' } = Astro.props;
const isHi = lang === 'hi';
---

<div class="my-10 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-[#f7faf7] via-white to-[#eaf5eb] border border-[#dce5dd] shadow-xs text-center space-y-4 not-prose">
  <div class="space-y-1.5">
    <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider text-[#15803d] bg-[#eaf5eb] border border-[#bbf7d0]">
      <span>✉️</span>
      <span>{isHi ? 'साप्ताहिक न्यूज़लेटर' : 'The Weekly Teardown'}</span>
    </span>
    <h3 class="font-serif font-black text-xl sm:text-2xl text-[#14241c]">
      {isHi ? 'हर हफ्ते सीधे अपने इनबॉक्स में पढ़ें' : 'Never miss an unvarnished verdict.'}
    </h3>
    <p class="text-xs sm:text-sm text-[#14241c]/70 max-w-lg mx-auto leading-relaxed">
      {isHi 
        ? 'सच्ची समीक्षाएं, मेटलर्जिकल तथ्य और वायरल दिखावे का पर्दाफाश। शून्य स्पैम, जब चाहें अनसब्सक्राइब करें।' 
        : 'Deep materials science, industrial design history, and honest de-influencing. Zero corporate sponsored fluff. Unsubscribe anytime.'}
    </p>
  </div>

  <!-- Sleek 1-Line Form Connecting to https://isitspecial.substack.com -->
  <form 
    action="https://isitspecial.substack.com/api/v1/free?nojs=true" 
    method="post" 
    target="_blank"
    class="max-w-md mx-auto flex flex-col sm:flex-row items-center gap-2 sm:gap-2 pt-2"
  >
    <div class="relative w-full">
      <input 
        type="email" 
        name="email" 
        required 
        placeholder={isHi ? 'अपना ईमेल दर्ज करें...' : 'Enter your email address...'} 
        class="w-full px-4 py-3 rounded-full border border-[#dce5dd] text-xs sm:text-sm bg-white text-[#14241c] placeholder-[#14241c]/45 focus:outline-none focus:border-[#15803d] focus:ring-2 focus:ring-[#15803d]/20 transition-all shadow-2xs"
      />
    </div>
    
    <button 
      type="submit" 
      class="w-full sm:w-auto shrink-0 px-6 py-3 rounded-full bg-[#15803d] hover:bg-[#166534] text-white text-xs font-bold uppercase tracking-wider transition-all duration-200 cursor-pointer shadow-xs hover:shadow-md active:scale-95 flex items-center justify-center space-x-1.5"
    >
      <span>{isHi ? 'सब्सक्राइब करें' : 'Subscribe'}</span>
      <span>&rarr;</span>
    </button>
  </form>

  <p class="text-[10px] text-[#14241c]/50">
    {isHi ? 'Substack द्वारा संचालित • कोई विज्ञापन नहीं' : 'Powered by Substack • 100% spam-free • One-click unsubscribe'}
  </p>
</div>
