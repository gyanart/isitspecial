---
interface Props {
  title: string;
  url?: string;
  lang?: 'en' | 'hi';
}

const { title, url, lang = 'en' } = Astro.props;
const isHi = lang === 'hi';
const whatsappChannelUrl = 'https://whatsapp.com/channel/0029VbE0Bs69Gv7SoqV89q04';
---

<div class="my-8 py-5 border-y border-[#dce5dd]/80 flex flex-col sm:flex-row items-center justify-between gap-4 not-prose">
  
  <!-- Left: Share Headline & Channel Badge -->
  <div class="flex items-center space-x-3 text-xs">
    <span class="font-extrabold uppercase tracking-wider text-[#14241c]/60 font-mono">
      {isHi ? 'शेयर करें:' : 'Share This:'}
    </span>
    
    <!-- WhatsApp Channel Direct Join Pill -->
    <a 
      href={whatsappChannelUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-bold bg-[#25D366]/10 text-[#128C7E] border border-[#25D366]/30 hover:bg-[#25D366]/20 transition-all shadow-2xs"
    >
      <!-- WhatsApp Vector Icon -->
      <svg class="w-3.5 h-3.5 fill-current text-[#25D366]" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.529 1.835.811 2.791.811 3.18 0 5.766-2.587 5.767-5.766.001-3.181-2.585-5.767-5.767-5.797zm0 10.366c-.859 0-1.637-.238-2.316-.677l-.166-.108-1.574.412.42-1.535-.114-.183c-.47-.749-.718-1.583-.717-2.511.001-2.52 2.052-4.57 4.572-4.57 2.518 0 4.568 2.051 4.568 4.571-.001 2.521-2.051 4.571-4.573 4.571zM12 .001C5.372.001 0 5.373 0 12c0 2.115.548 4.103 1.509 5.836L0 24l6.336-1.464C8.016 23.473 9.96 24 12 24c6.628 0 12-5.373 12-12S18.628.001 12 .001z"/>
      </svg>
      <span>{isHi ? 'व्हाट्सएप चैनल' : 'WhatsApp Channel'}</span>
    </a>
  </div>

  <!-- Right: Social Share Actions & Bookmark -->
  <div class="flex items-center space-x-2">
    
    <!-- 1-Click WhatsApp Share -->
    <button 
      id="share-whatsapp-btn" 
      class="px-3.5 py-1.5 rounded-full bg-white border border-[#dce5dd] hover:border-[#25D366] text-[#14241c] hover:text-[#25D366] text-xs font-semibold flex items-center space-x-1.5 shadow-2xs transition-all cursor-pointer"
      title="Share on WhatsApp"
    >
      <svg class="w-3.5 h-3.5 fill-current text-[#25D366]" viewBox="0 0 24 24">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.529 1.835.811 2.791.811 3.18 0 5.766-2.587 5.767-5.766.001-3.181-2.585-5.767-5.767-5.797zm0 10.366c-.859 0-1.637-.238-2.316-.677l-.166-.108-1.574.412.42-1.535-.114-.183c-.47-.749-.718-1.583-.717-2.511.001-2.52 2.052-4.57 4.572-4.57 2.518 0 4.568 2.051 4.568 4.571-.001 2.521-2.051 4.571-4.573 4.571zM12 .001C5.372.001 0 5.373 0 12c0 2.115.548 4.103 1.509 5.836L0 24l6.336-1.464C8.016 23.473 9.96 24 12 24c6.628 0 12-5.373 12-12S18.628.001 12 .001z"/>
      </svg>
      <span>WhatsApp</span>
    </button>

    <!-- 1-Click X / Twitter Share -->
    <button 
      id="share-x-btn" 
      class="px-3.5 py-1.5 rounded-full bg-white border border-[#dce5dd] hover:border-black text-[#14241c] text-xs font-semibold flex items-center space-x-1.5 shadow-2xs transition-all cursor-pointer"
      title="Share on X"
    >
      <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
      <span>Post</span>
    </button>

    <!-- Copy Link Button -->
    <button 
      id="copy-link-btn" 
      class="px-3.5 py-1.5 rounded-full bg-white border border-[#dce5dd] hover:border-[#15803d] text-[#14241c] hover:text-[#15803d] text-xs font-semibold flex items-center space-x-1.5 shadow-2xs transition-all cursor-pointer"
      title="Copy Link"
    >
      <svg class="w-3.5 h-3.5 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </svg>
      <span id="copy-btn-text">{isHi ? 'लिंक कॉपी' : 'Copy'}</span>
    </button>

    <!-- Bookmark / Save Button -->
    <button 
      id="bookmark-article-btn" 
      class="px-3.5 py-1.5 rounded-full bg-[#f7faf7] border border-[#dce5dd] hover:border-rose-400 text-[#14241c] text-xs font-semibold flex items-center space-x-1.5 shadow-2xs transition-all cursor-pointer group"
      title="Save to Reading List"
    >
      <svg id="bookmark-heart-icon" class="w-3.5 h-3.5 fill-none stroke-current text-[#14241c]/70 group-hover:text-rose-500 transition-colors" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
      </svg>
      <span id="bookmark-btn-text">{isHi ? 'सेव करें' : 'Save'}</span>
    </button>

  </div>

</div>

<script is:inline define:vars={{ articleTitle: title }}>
  // Share on WhatsApp
  document.getElementById('share-whatsapp-btn')?.addEventListener('click', () => {
    const text = `🔍 "${articleTitle}" — Is it genuinely special? Read the unvarnished verdict:\n${window.location.href}`;
    window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank');
  });

  // Share on X
  document.getElementById('share-x-btn')?.addEventListener('click', () => {
    const text = `Is "${articleTitle}" actually special or just marketing hype? Tested & reviewed:`;
    window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(window.location.href)}`, '_blank');
  });

  // 1-Click Copy Link
  document.getElementById('copy-link-btn')?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      const textSpan = document.getElementById('copy-btn-text');
      if (textSpan) {
        const originalText = textSpan.innerText;
        textSpan.innerText = '✓ Copied!';
        setTimeout(() => { textSpan.innerText = originalText; }, 2000);
      }
    } catch (e) {
      console.error('Clipboard copy failed', e);
    }
  });

  // LocalStorage Bookmark System
  const articleId = window.location.pathname;
  const bookmarkBtn = document.getElementById('bookmark-article-btn');
  const bookmarkText = document.getElementById('bookmark-btn-text');
  const heartIcon = document.getElementById('bookmark-heart-icon');

  function getSavedArticles() {
    try {
      return JSON.parse(localStorage.getItem('isitspecial_saved') || '[]');
    } catch {
      return [];
    }
  }

  function updateBookmarkUI() {
    const saved = getSavedArticles();
    const isSaved = saved.some(item => item.url === articleId);
    if (isSaved) {
      bookmarkText.innerText = 'Saved ❤️';
      heartIcon.classList.add('fill-rose-500', 'text-rose-500');
      heartIcon.classList.remove('fill-none');
    } else {
      bookmarkText.innerText = 'Save';
      heartIcon.classList.remove('fill-rose-500', 'text-rose-500');
      heartIcon.classList.add('fill-none');
    }
  }

  bookmarkBtn?.addEventListener('click', () => {
    const saved = getSavedArticles();
    const existingIndex = saved.findIndex(item => item.url === articleId);
    if (existingIndex > -1) {
      saved.splice(existingIndex, 1);
    } else {
      saved.push({
        title: articleTitle,
        url: articleId,
        date: new Date().toISOString()
      });
    }
    localStorage.setItem('isitspecial_saved', JSON.stringify(saved));
    updateBookmarkUI();
    // Dispatch custom event so header saved count updates
    window.dispatchEvent(new Event('bookmarks-updated'));
  });

  updateBookmarkUI();
</script>
