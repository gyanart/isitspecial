---
interface Props {
  lang?: 'en' | 'hi';
  translationUrl?: string;
}

const { lang = 'en', translationUrl } = Astro.props;

const enNavLinks = [
  { href: '/', label: 'Feed' },
  { href: '/about', label: 'Manifesto' },
  { href: '/contact', label: 'Submit Item' },
];

const hiNavLinks = [
  { href: '/hi', label: 'होम' },
  { href: '/about', label: 'हमारा मिशन' },
  { href: '/contact', label: 'सुझाव भेजें' },
];

const currentLinks = lang === 'hi' ? hiNavLinks : enNavLinks;

// Target URL when switching language
const targetEnUrl = lang === 'hi' ? (translationUrl || '/') : '#';
const targetHiUrl = lang === 'en' ? (translationUrl || '/hi') : '#';
---

<header class="border-b border-zinc-200/80 bg-white/90 backdrop-blur-md sticky top-0 z-40 transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between">
    
    <!-- Logo & Brand Badge -->
    <div class="flex items-center space-x-3">
      <a href={lang === 'hi' ? '/hi' : '/'} class="group flex items-center space-x-2 text-zinc-900 transition-colors">
        <span class="w-8 h-8 rounded-xl bg-zinc-950 text-white font-serif font-black flex items-center justify-center text-sm shadow-xs group-hover:bg-amber-600 transition-colors">
          ?
        </span>
        <span class="text-xl font-black tracking-tight uppercase font-serif text-zinc-900 group-hover:text-amber-600 transition-colors">
          IS IT SPECIAL<span class="text-amber-600">.</span>
        </span>
      </a>
      <span class="hidden md:inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-zinc-100 text-zinc-600 border border-zinc-200">
        {lang === 'hi' ? 'समीक्षा एवं शोध' : 'Critical Evaluations'}
      </span>
    </div>

    <!-- Navigation & Modern Language Segmented Switcher -->
    <div class="flex items-center space-x-4 sm:space-x-6">
      <nav class="hidden sm:flex items-center space-x-6 text-sm font-medium text-zinc-600">
        {currentLinks.map((link) => (
          <a href={link.href} class="hover:text-zinc-950 transition-colors">
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Language Switcher Pill (EN | हिन्दी) -->
      <div class="inline-flex items-center rounded-full p-1 bg-zinc-100 border border-zinc-200 text-xs font-semibold">
        <a 
          href={targetEnUrl} 
          class={`px-3 py-1 rounded-full transition-all ${
            lang === 'en' 
              ? 'bg-zinc-950 text-white shadow-xs font-bold' 
              : 'text-zinc-600 hover:text-zinc-950'
          }`}
          title="Switch to English"
        >
          EN
        </a>
        <a 
          href={targetHiUrl} 
          class={`px-3 py-1 rounded-full transition-all ${
            lang === 'hi' 
              ? 'bg-amber-600 text-white shadow-xs font-bold' 
              : 'text-zinc-600 hover:text-zinc-950 font-devanagari'
          }`}
          title="हिंदी में बदलें"
        >
          हिन्दी
        </a>
      </div>

      <!-- Action Button -->
      <a 
        href={lang === 'hi' ? '/hi#articles' : '/#articles'} 
        class="hidden lg:inline-flex items-center px-4 py-2 rounded-xl text-xs font-bold bg-zinc-950 text-white hover:bg-zinc-800 transition-all shadow-xs"
      >
        {lang === 'hi' ? 'समीक्षाएं देखें' : 'Browse Verdicts'}
      </a>
    </div>

  </div>
</header>
