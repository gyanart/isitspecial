---
interface Props {
  slotId?: string;
  format?: 'horizontal' | 'rectangle' | 'sidebar';
  label?: string;
}

const { 
  slotId = 'DEV_SLOT', 
  format = 'horizontal', 
  label = 'Advertisement' 
} = Astro.props;

const formatStyles = {
  horizontal: 'min-h-[100px] sm:min-h-[120px] max-w-3xl',
  rectangle: 'min-h-[250px] max-w-sm',
  sidebar: 'min-h-[600px] w-full'
};
---

<div class={`ad-container my-8 mx-auto w-full flex flex-col items-center justify-center ${formatStyles[format]}`}>
  <span class="text-[10px] tracking-widest text-stone-600 uppercase mb-1 font-mono">{label}</span>
  <div class="w-full h-full min-h-[90px] border border-dashed border-stone-300 rounded-lg bg-stone-100/60 flex items-center justify-center text-xs text-stone-600 font-mono p-4 text-center">
    <!-- Google AdSense Unit Container: Zero CLS Reserved Space -->
    <div class="space-y-1">
      <div class="text-stone-600 font-semibold">Ad Unit Ready [{format}]</div>
      <div class="text-[10px] text-stone-600">ID: {slotId} (Reserved for Google AdSense)</div>
    </div>
  </div>
</div>
