---
interface Props {
  slotId?: string;
  format?: 'horizontal' | 'rectangle' | 'sidebar';
  label?: string;
}

const { 
  slotId = 'DEV_SLOT', 
  format = 'horizontal', 
  label = 'Advertisement' 
} = Astro.props;

const formatStyles = {
  horizontal: 'min-h-[100px] sm:min-h-[120px] max-w-4xl',
  rectangle: 'min-h-[250px] max-w-sm',
  sidebar: 'min-h-[600px] w-full'
};
---

<div class={`ad-container my-8 mx-auto w-full flex flex-col items-center justify-center ${formatStyles[format]}`}>
  <span class="text-[10px] tracking-widest text-[#14241c]/50 uppercase mb-1 font-mono">{label}</span>
  <div class="w-full h-full min-h-[90px] border border-dashed border-[#cbdad0] rounded-2xl bg-[#f1f6f2]/80 flex items-center justify-center text-xs text-[#14241c]/60 font-mono p-5 text-center shadow-2xs">
    <!-- Google AdSense Unit Container: Zero CLS Reserved Space -->
    <div class="space-y-1">
      <div class="text-[#15803d] font-bold text-xs uppercase tracking-wider font-sans">
        AdSense Unit Ready [{format}]
      </div>
      <div class="text-[10px] text-[#14241c]/50 font-mono">
        Slot: {slotId} &bull; Zero-CLS Reserved Container
      </div>
    </div>
  </div>
</div>
