---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  category: string;
  specialScore: number;
  specialVerdict: string;
  readingTime: string;
  heroImage?: string;
  lang?: 'en' | 'hi';
}

const { 
  title, 
  description, 
  pubDate, 
  slug, 
  category, 
  specialScore, 
  specialVerdict,
  readingTime,
  heroImage,
  lang = 'en'
} = Astro.props;

const isHi = lang === 'hi';

const formattedDate = new Intl.DateTimeFormat(isHi ? 'hi-IN' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}).format(pubDate);

// Dynamic verdict color
const isOverhyped = specialVerdict.toLowerCase().includes('overhyped') || specialVerdict.includes('ओवरहाइप्ड');
const isMasterpiece = specialVerdict.toLowerCase().includes('masterpiece') || specialVerdict.includes('मास्टरपीस');
const isGem = specialVerdict.toLowerCase().includes('gem') || specialVerdict.includes('नगीना');

const verdictColor = isOverhyped
  ? 'text-rose-600'
  : isMasterpiece
  ? 'text-indigo-600'
  : isGem
  ? 'text-emerald-600'
  : 'text-amber-600';

const articleUrl = isHi ? `/hi/blog/${slug}` : `/blog/${slug}`;
---

<article class="group relative flex flex-col sm:flex-row sm:items-center gap-6 justify-between border-b border-stone-200 py-8 transition-colors">
  <div class="space-y-3 flex-1 min-w-0">
    <div class="flex items-center space-x-3 text-xs">
      <span class="font-semibold uppercase tracking-wider text-amber-700 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200/60">
        {category}
      </span>
      <span class="text-stone-600">&bull;</span>
      <time datetime={pubDate.toISOString()} class="text-stone-600">
        {formattedDate}
      </time>
      <span class="text-stone-600">&bull;</span>
      <span class="text-stone-600">{readingTime}</span>
    </div>

    <h2 class="font-serif text-2xl sm:text-3xl font-bold text-stone-900 group-hover:text-amber-800 transition-colors leading-snug">
      <a href={articleUrl}>
        <span class="absolute inset-0 z-10"></span>
        {title}
      </a>
    </h2>

    <p class="text-stone-600 text-sm sm:text-base leading-relaxed line-clamp-2">
      {description}
    </p>

    <div class="mt-4 flex items-center justify-between pt-3 border-t border-stone-100 text-xs">
      <div class="flex items-center space-x-2">
        <span class="font-mono text-stone-600 uppercase tracking-wider">
          {isHi ? 'निष्कर्ष:' : 'Verdict:'}
        </span>
        <span class={`font-bold uppercase tracking-wider ${verdictColor}`}>{specialVerdict}</span>
      </div>

      <div class="flex items-baseline space-x-1">
        <span class="text-stone-600">{isHi ? 'स्पेशल इंडेक्स:' : 'Special Index:'}</span>
        <span class="font-serif text-base font-bold text-stone-900">{specialScore.toFixed(1)}</span>
        <span class="text-stone-600">/10</span>
      </div>
    </div>
  </div>

  {heroImage && (
    <div class="w-full sm:w-44 sm:h-32 shrink-0 overflow-hidden rounded-2xl border border-stone-200 bg-stone-100 shadow-xs">
      <img 
        src={heroImage} 
        alt={title} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
        loading="lazy" 
      />
    </div>
  )}
</article>
