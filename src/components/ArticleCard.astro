---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  category: string;
  specialScore: number;
  specialVerdict: string;
  readingTime: string;
  heroImage?: string;
  lang?: 'en' | 'hi';
}

const { 
  title, 
  description, 
  pubDate, 
  slug, 
  category, 
  specialScore, 
  specialVerdict,
  readingTime,
  heroImage,
  lang = 'en'
} = Astro.props;

const isHi = lang === 'hi';

const formattedDate = new Intl.DateTimeFormat(isHi ? 'hi-IN' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}).format(pubDate);

// Dynamic verdict styling
const isOverhyped = specialVerdict.toLowerCase().includes('overhyped') || specialVerdict.includes('ओवरहाइप्ड');
const isMasterpiece = specialVerdict.toLowerCase().includes('masterpiece') || specialVerdict.includes('मास्टरपीस');
const isGem = specialVerdict.toLowerCase().includes('gem') || specialVerdict.includes('नगीना');

const verdictBadge = isOverhyped
  ? 'bg-rose-50 text-rose-700 border-rose-200'
  : isMasterpiece
  ? 'bg-indigo-50 text-indigo-700 border-indigo-200'
  : isGem
  ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
  : 'bg-amber-50 text-amber-800 border-amber-200';

const articleUrl = isHi ? `/hi/blog/${slug}` : `/blog/${slug}`;
---

<article class="group relative bg-white border border-zinc-200/80 rounded-2xl p-5 sm:p-6 card-hover flex flex-col sm:flex-row gap-6 justify-between items-start my-4">
  <div class="space-y-3 flex-1 min-w-0">
    
    <!-- Category & Date Meta -->
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="font-bold uppercase tracking-wider text-zinc-900 bg-zinc-100 px-2.5 py-0.5 rounded-md border border-zinc-200">
        {category}
      </span>
      <span class="text-zinc-600">&bull;</span>
      <time datetime={pubDate.toISOString()} class="text-zinc-600 font-mono text-[11px]">
        {formattedDate}
      </time>
      <span class="text-zinc-600">&bull;</span>
      <span class="text-zinc-600 text-[11px]">{readingTime}</span>
    </div>

    <!-- Title -->
    <h2 class="font-serif text-xl sm:text-2xl font-bold text-zinc-900 group-hover:text-amber-600 transition-colors leading-snug">
      <a href={articleUrl}>
        <span class="absolute inset-0 z-10"></span>
        {title}
      </a>
    </h2>

    <!-- Description -->
    <p class="text-zinc-600 text-sm sm:text-base leading-relaxed line-clamp-2">
      {description}
    </p>

    <!-- Score & Verdict Footer -->
    <div class="pt-4 border-t border-zinc-100 flex items-center justify-between text-xs">
      <div class="flex items-center space-x-2">
        <span class="text-[11px] font-mono text-zinc-600 uppercase tracking-wider">
          {isHi ? 'निष्कर्ष:' : 'Verdict:'}
        </span>
        <span class={`font-bold px-2 py-0.5 rounded-full border text-[11px] uppercase tracking-wider ${verdictBadge}`}>
          {specialVerdict}
        </span>
      </div>

      <div class="flex items-baseline space-x-1 bg-zinc-50 px-2.5 py-1 rounded-lg border border-zinc-200/60">
        <span class="text-[10px] font-mono uppercase text-zinc-600">Score:</span>
        <span class="font-serif text-base font-black text-zinc-900">{specialScore.toFixed(1)}</span>
        <span class="text-[10px] text-zinc-600 font-mono">/10</span>
      </div>
    </div>
  </div>

  <!-- Thumbnail Photo with Zoom Effect -->
  {heroImage && (
    <div class="w-full sm:w-52 h-44 sm:h-36 shrink-0 overflow-hidden rounded-xl border border-zinc-200 bg-zinc-100 shadow-xs relative">
      <img 
        src={heroImage} 
        alt={title} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
        loading="lazy" 
      />
    </div>
  )}
</article>
