---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  category: string;
  specialScore: number;
  specialVerdict: string;
  readingTime: string;
  heroImage?: string;
  lang?: 'en' | 'hi';
}

const { 
  title, 
  description, 
  pubDate, 
  slug, 
  category, 
  specialScore, 
  specialVerdict,
  readingTime,
  heroImage,
  lang = 'en'
} = Astro.props;

const isHi = lang === 'hi';

// Smart origin country tag mapping
const cleanSlug = slug.replace(/^hi\//, '');
const originMap: Record<string, string> = {
  'casio-f91w-watch-masterpiece': isHi ? 'जापान 🇯🇵' : 'Japan 🇯🇵',
  'japanese-selvedge-denim': isHi ? 'जापान 🇯🇵' : 'Japan 🇯🇵',
  'stanley-tumbler-hype': isHi ? 'अमेरिका 🇺🇸' : 'USA 🇺🇸',
  'lodge-cast-iron-skillet': isHi ? 'अमेरिका 🇺🇸' : 'USA 🇺🇸',
  'bic-cristal-ballpoint-pen': isHi ? 'फ्रांस 🇫🇷' : 'France 🇫🇷',
  'dyson-supersonic-hair-dryer': isHi ? 'ब्रिटेन 🇬🇧' : 'UK 🇬🇧',
};
const origin = originMap[cleanSlug] || (isHi ? 'ग्लोबल 🌐' : 'Global 🌐');

// Dynamic verdict styling with Grasshopper palette
const isOverhyped = specialVerdict.toLowerCase().includes('overhyped') || specialVerdict.includes('ओवरहाइप्ड');
const isMasterpiece = specialVerdict.toLowerCase().includes('masterpiece') || specialVerdict.includes('मास्टरपीस');
const isGem = specialVerdict.toLowerCase().includes('gem') || specialVerdict.includes('नगीना');

const verdictBadge = isOverhyped
  ? 'bg-rose-50 text-rose-700 border border-rose-200'
  : isMasterpiece
  ? 'bg-[#eaf5eb] text-[#15803d] border border-[#bbf7d0]'
  : isGem
  ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
  : 'bg-amber-50 text-amber-800 border border-amber-200';

const articleUrl = isHi ? `/hi/blog/${slug}` : `/blog/${slug}`;
---

<article class="group relative bg-white border border-[#dce5dd]/90 rounded-3xl overflow-hidden card-hover flex flex-col justify-between shadow-xs">
  
  <!-- Top Thumbnail Container with Origin Badge & Favorite Heart -->
  <div class="relative m-3.5 mb-0 rounded-2xl overflow-hidden aspect-[16/10] bg-[#eaf5eb]">
    {heroImage ? (
      <img 
        src={heroImage} 
        alt={title} 
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
        loading="lazy" 
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-[#15803d] font-bold">
        Is It Special?
      </div>
    )}

    <!-- Origin Pill Badge (Bottom-Left) -->
    <span class="absolute bottom-2.5 left-2.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-black/60 text-white backdrop-blur-md shadow-sm">
      {origin}
    </span>

    <!-- Bookmark / Favorite Icon (Top-Right) -->
    <div class="absolute top-2.5 right-2.5 w-8 h-8 rounded-full bg-white/85 backdrop-blur-md flex items-center justify-center text-[#14241c]/60 shadow-2xs group-hover:text-rose-500 transition-colors">
      <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
      </svg>
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between space-y-4">
    
    <div class="space-y-2.5">
      <!-- Category & Verdict Meta Chips -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[10px] font-extrabold uppercase tracking-wider text-[#15803d]">
          {category}
        </span>
        <span class="text-[#dce5dd]">&bull;</span>
        <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md ${verdictBadge}`}>
          {specialVerdict}
        </span>
      </div>

      <!-- Title in Bitter Serif Font -->
      <h2 class="font-serif text-lg sm:text-xl font-bold text-[#14241c] group-hover:text-[#15803d] transition-colors leading-snug line-clamp-2">
        <a href={articleUrl}>
          <span class="absolute inset-0 z-10"></span>
          {title}
        </a>
      </h2>

      <!-- Description -->
      <p class="text-xs sm:text-sm text-[#14241c]/70 line-clamp-2 leading-relaxed">
        {description}
      </p>
    </div>

    <!-- Card Bottom Footer (Reading Time & Rating Star Score) -->
    <div class="pt-4 border-t border-[#dce5dd]/60 flex items-center justify-between text-xs text-[#14241c]/70">
      <div class="flex items-center space-x-1.5 font-medium">
        <span>⏱️</span>
        <span>{readingTime}</span>
      </div>

      <div class="flex items-center space-x-1 font-bold text-[#15803d] font-serif text-sm">
        <span class="text-amber-500 text-xs">★</span>
        <span>{specialScore.toFixed(1)}</span>
        <span class="text-[10px] text-[#14241c]/50 font-sans font-normal">/10</span>
      </div>
    </div>

  </div>

</article>
