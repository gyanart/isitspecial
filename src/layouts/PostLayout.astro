---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';

interface PostItem {
  id: string;
  data: {
    title: string;
    description: string;
    pubDate: Date;
    category: string;
    specialScore: number;
    specialVerdict: string;
    readingTime: string;
    heroImage?: string;
    lang?: 'en' | 'hi';
  };
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  heroImageAlt?: string;
  category: string;
  author: string;
  authorRole: string;
  specialScore: number;
  specialVerdict: string;
  readingTime: string;
  currentSlug?: string;
  lang?: 'en' | 'hi';
  translationUrl?: string;
  relatedPosts?: PostItem[];
  recentPosts?: PostItem[];
  allPosts?: PostItem[];
}

const {
  title,
  description,
  pubDate,
  heroImage,
  heroImageAlt,
  category,
  author,
  authorRole,
  specialScore,
  specialVerdict,
  readingTime,
  lang = 'en',
  translationUrl,
  relatedPosts = [],
  recentPosts = [],
  allPosts = [],
} = Astro.props;

const isHi = lang === 'hi';

const formattedDate = new Intl.DateTimeFormat(isHi ? 'hi-IN' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(pubDate);

// Dynamic verdict colors
const isOverhyped = specialVerdict.toLowerCase().includes('overhyped') || specialVerdict.includes('ओवरहाइप्ड');
const isMasterpiece = specialVerdict.toLowerCase().includes('masterpiece') || specialVerdict.includes('मास्टरपीस');
const isGem = specialVerdict.toLowerCase().includes('gem') || specialVerdict.includes('नगीना');

const verdictTheme = isOverhyped
  ? { badge: 'bg-rose-50 text-rose-700 border-rose-200', score: 'text-rose-600' }
  : isMasterpiece
  ? { badge: 'bg-indigo-50 text-indigo-700 border-indigo-200', score: 'text-indigo-600' }
  : isGem
  ? { badge: 'bg-emerald-50 text-emerald-700 border-emerald-200', score: 'text-emerald-600' }
  : { badge: 'bg-amber-50 text-amber-800 border-amber-200', score: 'text-amber-600' };

// Calculate Category Counts filtered by current language
const currentLangPosts = allPosts.filter(p => (p.data.lang || 'en') === lang);
const categoriesWithCount = Array.from(new Set(currentLangPosts.map(p => p.data.category))).map(cat => ({
  name: cat,
  count: currentLangPosts.filter(p => p.data.category === cat).length
}));
---

<BaseLayout 
  title={`${title} | ${isHi ? 'इज इट स्पेशल?' : 'Is It Special?'}`} 
  description={description} 
  type="article"
  image={heroImage}
  lang={lang}
  translationUrl={translationUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Review",
      "headline": title,
      "description": description,
      "inLanguage": isHi ? "hi" : "en",
      "image": heroImage ? (heroImage.startsWith('http') ? heroImage : `https://www.isitspecial.com${heroImage}`) : undefined,
      "datePublished": pubDate.toISOString(),
      "author": {
        "@type": "Organization",
        "name": author,
        "url": "https://www.isitspecial.com/about"
      },
      "publisher": {
        "@type": "Organization",
        "name": isHi ? "इज इट स्पेशल?" : "Is It Special?",
        "url": "https://www.isitspecial.com"
      },
      "itemReviewed": {
        "@type": "Product",
        "name": title
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": specialScore,
        "bestRating": "10",
        "worstRating": "1"
      }
    })} />
  </Fragment>

  <!-- Article Hero Header (Full-width clean white section matching Homepage) -->
  <header class="border-b border-zinc-200/80 bg-white py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-6">
      
      <!-- Category Badge & Breadcrumbs -->
      <div class="flex items-center justify-center space-x-2 text-xs font-bold uppercase tracking-wider">
        <a href={isHi ? '/hi' : '/'} class="text-zinc-500 hover:text-zinc-950 transition-colors">
          {isHi ? 'होम' : 'Investigations'}
        </a>
        <span class="text-zinc-300">/</span>
        <span class="px-2.5 py-0.5 rounded-full bg-zinc-100 text-zinc-900 border border-zinc-200">
          {category}
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-extrabold text-zinc-950 tracking-tight leading-[1.12]">
        {title}
      </h1>

      <!-- Subtitle / Hook -->
      <p class="text-zinc-600 text-lg sm:text-xl font-normal leading-relaxed max-w-2xl mx-auto">
        {description}
      </p>

      <!-- Author, Date, Reading Time, and Special Index Pill -->
      <div class="pt-2 flex flex-wrap items-center justify-center gap-3 text-xs text-zinc-600">
        <div class="flex items-center space-x-2 bg-zinc-50 px-3 py-1.5 rounded-full border border-zinc-200">
          <div class="w-5 h-5 rounded-full bg-zinc-950 text-white flex items-center justify-center font-bold text-[10px] uppercase">
            {author.charAt(0)}
          </div>
          <span class="font-bold text-zinc-900">{author}</span>
          <span class="text-zinc-400">&bull;</span>
          <span class="text-zinc-500">{authorRole}</span>
        </div>

        <span class="text-zinc-300 hidden sm:inline">&bull;</span>
        <time datetime={pubDate.toISOString()} class="font-mono text-xs">{formattedDate}</time>
        <span class="text-zinc-300">&bull;</span>
        <span class="font-mono text-xs">{readingTime}</span>
        
        <span class="text-zinc-300">&bull;</span>
        <span class={`px-3 py-1 rounded-full border text-xs font-bold uppercase tracking-wider ${verdictTheme.badge}`}>
          {isHi ? 'निष्कर्ष: ' : 'Verdict: '} {specialVerdict} ({specialScore.toFixed(1)}/10)
        </span>
      </div>

      <!-- In-Article Bilingual Translation Switcher Banner -->
      {translationUrl && (
        <div class="pt-4 flex justify-center">
          <div class="inline-flex items-center gap-3 px-4 py-2 rounded-2xl bg-zinc-100/90 border border-zinc-200/90 text-xs shadow-xs">
            <span class="text-base">🌐</span>
            <span class="font-medium text-zinc-700">
              {isHi 
                ? 'Would you prefer to read this critique in English?' 
                : 'क्या आप इस लेख को हिंदी में पढ़ना चाहते हैं?'}
            </span>
            <a 
              href={translationUrl} 
              class="px-3.5 py-1 rounded-full text-xs font-bold bg-zinc-950 text-white hover:bg-zinc-800 transition-all shadow-xs"
            >
              {isHi ? 'Read in English →' : 'हिंदी में पढ़ें →'}
            </a>
          </div>
        </div>
      )}

    </div>
  </header>

  <!-- Main Container -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    
    <!-- Hero Image Banner -->
    {heroImage && (
      <div class="mb-10 overflow-hidden rounded-3xl border border-zinc-200/90 bg-white shadow-sm max-h-[500px]">
        <img 
          src={heroImage} 
          alt={heroImageAlt || title} 
          class="w-full h-full object-cover" 
          loading="eager"
        />
      </div>
    )}

    <!-- Top In-Content Ad Placeholder (Zero-CLS) -->
    <AdSlot format="horizontal" label="Advertisement (Top Leaderboard)" slotId="ISITSPECIAL_TOP_BANNER" />

    <!-- 2-Column Desktop Grid (Article Body + Sidebar) -->
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: The Editorial Magazine Paper (Span 8) -->
      <div class="lg:col-span-8 min-w-0 space-y-8">
        
        <!-- White Editorial Card Wrapper -->
        <div class="bg-white border border-zinc-200/90 rounded-3xl p-6 sm:p-10 lg:p-12 shadow-sm">
          <div class="prose prose-zinc prose-lg max-w-none 
            prose-headings:font-serif prose-headings:font-extrabold prose-headings:text-zinc-950 prose-headings:tracking-tight
            prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:pt-6 prose-h2:border-t prose-h2:border-zinc-100
            prose-p:leading-relaxed prose-p:text-zinc-800
            prose-blockquote:border-l-4 prose-blockquote:border-amber-500 prose-blockquote:bg-amber-50/50 prose-blockquote:py-3.5 prose-blockquote:px-6 prose-blockquote:rounded-r-2xl prose-blockquote:not-italic prose-blockquote:font-serif prose-blockquote:text-zinc-900
            prose-strong:text-zinc-950 prose-strong:font-bold
            prose-a:text-amber-700 prose-a:font-semibold hover:prose-a:text-amber-800">
            <slot />
          </div>

          <!-- Mid-Article In-Content Ad Placeholder (Zero-CLS) -->
          <div class="mt-12 not-prose">
            <AdSlot format="horizontal" label="Advertisement (In-Article Flow)" slotId="ISITSPECIAL_MID_BANNER" />
          </div>

          <!-- E-E-A-T Author Box (Required for Google Quality Raters & AdSense) -->
          <div class="not-prose mt-14 p-6 sm:p-8 rounded-2xl bg-zinc-50 border border-zinc-200/80">
            <div class="flex items-start space-x-4">
              <div class="w-12 h-12 rounded-2xl bg-zinc-950 text-white flex items-center justify-center font-bold text-lg font-serif shrink-0 shadow-xs">
                {author.charAt(0)}
              </div>
              <div class="space-y-1.5 flex-1">
                <div class="flex items-baseline space-x-2">
                  <h3 class="font-bold text-zinc-950 text-base">{author}</h3>
                  <span class="text-xs text-amber-700 font-bold uppercase tracking-wider">{authorRole}</span>
                </div>
                <p class="text-sm text-zinc-600 leading-relaxed">
                  {isHi
                    ? 'हमारे स्वतंत्र उत्पाद एवं संस्कृति परीक्षण डेस्क द्वारा लिखित। हम अपने परीक्षण उत्पाद स्वयं खरीदते हैं, कॉर्पोरेट स्पॉन्सरशिप अस्वीकार करते हैं, और वास्तविक परिस्थितियों में परीक्षण करके तय करते हैं कि क्या सचमुच बेहतरीन है और क्या केवल मार्केटिंग का दिखावा।'
                    : 'Written by our independent product & cultural testing desk. We purchase our own subjects, reject corporate sponsorship, and test items under everyday conditions to filter true quality from marketing hype.'}
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Related Articles Section (Bottom of Post) -->
        {relatedPosts.length > 0 && (
          <div class="pt-6">
            <div class="flex items-center justify-between mb-6">
              <div>
                <h3 class="font-serif text-2xl font-bold text-zinc-950">
                  {isHi ? 'संबंधित समीक्षाएं' : 'Related Investigations'}
                </h3>
                <p class="text-xs text-zinc-500 mt-0.5">
                  {isHi ? 'इस श्रेणी के अन्य उत्पाद' : `More critical teardowns in ${category}`}
                </p>
              </div>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-700 bg-amber-50 px-3 py-1 rounded-full border border-amber-200">
                {category}
              </span>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {relatedPosts.map((related) => {
                const relatedLink = related.data.lang === 'hi' 
                  ? `/hi/blog/${related.id.replace(/^hi\//, '')}` 
                  : `/blog/${related.id}`;
                return (
                  <a 
                    href={relatedLink} 
                    class="group block bg-white border border-zinc-200/90 rounded-2xl p-5 card-hover shadow-xs"
                  >
                    {related.data.heroImage && (
                      <div class="w-full h-36 rounded-xl overflow-hidden mb-4 bg-zinc-100 border border-zinc-200/60">
                        <img 
                          src={related.data.heroImage} 
                          alt={related.data.title} 
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                        />
                      </div>
                    )}
                    <div class="flex items-center justify-between text-xs text-zinc-500 mb-2">
                      <span class="font-bold text-zinc-800 uppercase tracking-wide text-[11px] bg-zinc-100 px-2 py-0.5 rounded">
                        {related.data.category}
                      </span>
                      <span class="font-mono font-bold bg-amber-50 text-amber-800 px-2 py-0.5 rounded border border-amber-200/60">
                        {related.data.specialScore.toFixed(1)}/10
                      </span>
                    </div>
                    <h4 class="font-serif text-base font-bold text-zinc-950 group-hover:text-amber-600 transition-colors line-clamp-2 leading-snug">
                      {related.data.title}
                    </h4>
                    <p class="text-xs text-zinc-600 mt-2 line-clamp-2 leading-relaxed">
                      {related.data.description}
                    </p>
                    <div class="mt-4 pt-3 border-t border-zinc-100 text-xs font-bold text-amber-700 group-hover:translate-x-1 transition-transform flex items-center space-x-1">
                      <span>{isHi ? 'पूरा निष्कर्ष पढ़ें' : 'Read Verdict'}</span>
                      <span>&rarr;</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}

      </div>

      <!-- Right Column: Sticky Sidebar Matching Homepage (Span 4) -->
      <aside class="lg:col-span-4 space-y-6 sticky top-20">
        
        <!-- Sidebar Widget 1: The Verdict Scorecard -->
        <div class="p-6 sm:p-7 rounded-3xl bg-white border border-zinc-200/90 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 font-mono">
              {isHi ? 'त्वरित स्कोरकार्ड' : 'The Scorecard'}
            </span>
            <span class={`px-2.5 py-0.5 rounded-full border text-[11px] font-bold uppercase tracking-wider ${verdictTheme.badge}`}>
              {specialVerdict}
            </span>
          </div>

          <div class="flex items-baseline space-x-2">
            <span class={`font-serif text-5xl font-black tracking-tight ${verdictTheme.score}`}>
              {specialScore.toFixed(1)}
            </span>
            <span class="text-zinc-600 font-bold uppercase text-xs font-mono">
              {isHi ? '/ 10 स्पेशल इंडेक्स' : '/ 10 Special Index'}
            </span>
          </div>

          <p class="text-xs text-zinc-600 leading-relaxed border-t border-zinc-100 pt-3">
            {isHi 
              ? 'हमारी रेटिंग सामग्री की गुणवत्ता, मरम्मत की सुविधा और टिकाऊ उपयोगिता पर आधारित है।' 
              : 'Evaluated on material craftsmanship, repairability, longevity, and price-to-utility ratio.'}
          </p>
        </div>

        <!-- Sidebar Widget 2: Recent Articles -->
        {recentPosts.length > 0 && (
          <div class="p-6 sm:p-7 rounded-3xl bg-white border border-zinc-200/90 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
              <h4 class="font-serif text-base font-bold text-zinc-950">
                {isHi ? 'हालिया समीक्षाएं' : 'Recent Drops'}
              </h4>
              <span class="text-[10px] font-mono text-zinc-600 uppercase bg-zinc-100 px-2 py-0.5 rounded">
                {isHi ? 'ताज़ा' : 'Latest'}
              </span>
            </div>

            <ul class="space-y-3.5 divide-y divide-zinc-100 text-xs">
              {recentPosts.map((recent, idx) => {
                const recentLink = recent.data.lang === 'hi' 
                  ? `/hi/blog/${recent.id.replace(/^hi\//, '')}` 
                  : `/blog/${recent.id}`;
                return (
                  <li class={idx > 0 ? 'pt-3' : ''}>
                    <a href={recentLink} class="group block space-y-1">
                      <span class="text-[10px] font-bold text-amber-700 uppercase tracking-wide block">
                        {recent.data.category} &bull; {recent.data.specialScore.toFixed(1)}/10
                      </span>
                      <h5 class="font-serif text-sm font-semibold text-zinc-950 group-hover:text-amber-600 transition-colors leading-snug">
                        {recent.data.title}
                      </h5>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        )}

        <!-- Sidebar Widget 3: Categories & Editorial Pillars -->
        {categoriesWithCount.length > 0 && (
          <div class="p-6 sm:p-7 rounded-3xl bg-white border border-zinc-200/90 shadow-sm space-y-4">
            <h4 class="font-serif text-base font-bold text-zinc-950 border-b border-zinc-100 pb-3">
              {isHi ? 'विषय के अनुसार खोजें' : 'Editorial Pillars'}
            </h4>
            <ul class="space-y-1.5 text-xs">
              {categoriesWithCount.map((cat) => (
                <li>
                  <a 
                    href={isHi ? '/hi#articles' : '/#articles'} 
                    class="flex items-center justify-between p-2.5 rounded-xl hover:bg-zinc-50 transition-colors text-zinc-700 font-medium"
                  >
                    <span>{cat.name}</span>
                    <span class="px-2 py-0.5 rounded-full bg-zinc-100 text-zinc-700 font-mono text-[11px] font-bold border border-zinc-200/60">
                      {cat.count}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Sidebar Widget 4: Sticky Skyscraper AdSense Placeholder (Zero-CLS) -->
        <AdSlot format="sidebar" label="Advertisement (Sticky Sidebar)" slotId="ISITSPECIAL_SIDEBAR_STICKY" />

      </aside>

    </div>

  </div>
</BaseLayout>
