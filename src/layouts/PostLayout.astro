---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';

interface PostItem {
  id: string;
  data: {
    title: string;
    description: string;
    pubDate: Date;
    category: string;
    specialScore: number;
    specialVerdict: string;
    readingTime: string;
    lang?: 'en' | 'hi';
  };
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  heroImageAlt?: string;
  category: string;
  author: string;
  authorRole: string;
  specialScore: number;
  specialVerdict: string;
  readingTime: string;
  currentSlug?: string;
  lang?: 'en' | 'hi';
  translationUrl?: string;
  relatedPosts?: PostItem[];
  recentPosts?: PostItem[];
  allPosts?: PostItem[];
}

const {
  title,
  description,
  pubDate,
  heroImage,
  heroImageAlt,
  category,
  author,
  authorRole,
  specialScore,
  specialVerdict,
  readingTime,
  lang = 'en',
  translationUrl,
  relatedPosts = [],
  recentPosts = [],
  allPosts = [],
} = Astro.props;

const isHi = lang === 'hi';

const formattedDate = new Intl.DateTimeFormat(isHi ? 'hi-IN' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(pubDate);

// Dynamic verdict color
const isOverhyped = specialVerdict.toLowerCase().includes('overhyped') || specialVerdict.includes('ओवरहाइप्ड');
const isMasterpiece = specialVerdict.toLowerCase().includes('masterpiece') || specialVerdict.includes('मास्टरपीस');
const isGem = specialVerdict.toLowerCase().includes('gem') || specialVerdict.includes('नगीना');

const verdictColor = isOverhyped
  ? 'bg-rose-100 text-rose-800 border-rose-200'
  : isMasterpiece
  ? 'bg-indigo-100 text-indigo-800 border-indigo-200'
  : isGem
  ? 'bg-emerald-100 text-emerald-800 border-emerald-200'
  : 'bg-amber-100 text-amber-800 border-amber-200';

// Calculate Category Counts filtered by current language
const currentLangPosts = allPosts.filter(p => (p.data.lang || 'en') === lang);
const categoriesWithCount = Array.from(new Set(currentLangPosts.map(p => p.data.category))).map(cat => ({
  name: cat,
  count: currentLangPosts.filter(p => p.data.category === cat).length
}));
---

<BaseLayout 
  title={`${title} | ${isHi ? 'इज इट स्पेशल?' : 'Is It Special?'}`} 
  description={description} 
  type="article"
  lang={lang}
  translationUrl={translationUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Review",
      "headline": title,
      "description": description,
      "inLanguage": isHi ? "hi" : "en",
      "image": heroImage ? (heroImage.startsWith('http') ? heroImage : `https://www.isitspecial.com${heroImage}`) : undefined,
      "datePublished": pubDate.toISOString(),
      "author": {
        "@type": "Organization",
        "name": author,
        "url": "https://www.isitspecial.com/about"
      },
      "publisher": {
        "@type": "Organization",
        "name": isHi ? "इज इट स्पेशल?" : "Is It Special?",
        "url": "https://www.isitspecial.com"
      },
      "itemReviewed": {
        "@type": "Product",
        "name": title
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": specialScore,
        "bestRating": "10",
        "worstRating": "1"
      }
    })} />
  </Fragment>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    
    <!-- Header Meta & Title (Centered) -->
    <header class="max-w-3xl mx-auto text-center space-y-4 pb-8 border-b border-stone-200">
      <div class="flex items-center justify-center space-x-2 text-xs">
        <a href={isHi ? '/hi' : '/'} class="text-stone-600 hover:text-stone-900 transition-colors uppercase tracking-wider font-semibold">
          {isHi ? 'समीक्षाएं' : 'Articles'}
        </a>
        <span class="text-stone-600">/</span>
        <span class="text-amber-800 uppercase tracking-wider font-semibold">{category}</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl font-extrabold text-stone-900 tracking-tight leading-[1.18]">
        {title}
      </h1>

      <p class="text-stone-600 text-lg sm:text-xl font-normal leading-relaxed max-w-2xl mx-auto">
        {description}
      </p>

      <!-- Author and Date Meta -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-3 text-xs text-stone-600">
        <div class="flex items-center space-x-2">
          <div class="w-7 h-7 rounded-full bg-amber-700 text-stone-50 flex items-center justify-center font-bold text-xs uppercase">
            {author.charAt(0)}
          </div>
          <span class="font-semibold text-stone-900">{author}</span>
          <span class="text-stone-600">({authorRole})</span>
        </div>
        <span class="text-stone-600">&bull;</span>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span class="text-stone-600">&bull;</span>
        <span>{readingTime}</span>
        <span class="text-stone-600">&bull;</span>
        <span class={`px-2.5 py-0.5 rounded-full border text-[11px] font-bold uppercase tracking-wider ${verdictColor}`}>
          {isHi ? 'निष्कर्ष: ' : 'Verdict: '} {specialVerdict} ({specialScore.toFixed(1)}/10)
        </span>
      </div>

      <!-- In-Article Direct Language Switcher Callout -->
      {translationUrl && (
        <div class="mt-6 pt-4 border-t border-stone-100 flex justify-center">
          <div class={`inline-flex items-center gap-3 px-4 py-2.5 rounded-2xl border text-xs shadow-xs ${
            isHi ? 'bg-amber-50/80 border-amber-200 text-amber-950' : 'bg-stone-100/90 border-stone-300/80 text-stone-900'
          }`}>
            <span class="text-base">🌐</span>
            <span class="font-medium">
              {isHi 
                ? 'Would you prefer to read this article in English?' 
                : 'क्या आप इस लेख को हिंदी में पढ़ना चाहते हैं?'}
            </span>
            <a 
              href={translationUrl} 
              class={`ml-1 px-3 py-1 rounded-full text-xs font-bold transition-all shadow-xs ${
                isHi 
                  ? 'bg-amber-800 text-stone-50 hover:bg-amber-900' 
                  : 'bg-stone-900 text-stone-50 hover:bg-stone-800'
              }`}
            >
              {isHi ? 'Read in English →' : 'हिंदी में पढ़ें →'}
            </a>
          </div>
        </div>
      )}
    </header>

    <!-- Hero Image Banner -->
    {heroImage && (
      <div class="max-w-4xl mx-auto my-8 overflow-hidden rounded-3xl border border-stone-200 bg-stone-100 shadow-xs">
        <img 
          src={heroImage} 
          alt={heroImageAlt || title} 
          class="w-full h-[260px] sm:h-[440px] object-cover" 
          loading="eager"
        />
      </div>
    )}

    <!-- Top In-Content Ad Placeholder (Zero-CLS) -->
    <div class="max-w-4xl mx-auto mt-4">
      <AdSlot format="horizontal" label="Advertisement (Top Leaderboard)" slotId="ISITSPECIAL_TOP_BANNER" />
    </div>

    <!-- Main Content & Sidebar Grid (Desktop 8 / 4 Grid) -->
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: The Editorial Article (Span 8) -->
      <div class="lg:col-span-8 min-w-0">
        <div class="prose prose-zinc prose-lg max-w-none 
          prose-headings:font-serif prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-zinc-950
          prose-p:leading-relaxed prose-p:text-zinc-800
          prose-blockquote:border-l-4 prose-blockquote:border-amber-500 prose-blockquote:bg-amber-50/40 prose-blockquote:py-3 prose-blockquote:px-5 prose-blockquote:rounded-r-xl prose-blockquote:not-italic prose-blockquote:font-serif
          prose-strong:text-zinc-950 prose-strong:font-bold
          prose-a:text-amber-700 prose-a:font-semibold hover:prose-a:text-amber-800">
          <slot />
        </div>

        <!-- Mid-Article In-Content Ad Placeholder (Zero-CLS) -->
        <AdSlot format="horizontal" label="Advertisement (Mid-Article Flow)" slotId="ISITSPECIAL_MID_BANNER" />

        <!-- E-E-A-T Author Box (Required for Google Quality Raters & AdSense) -->
        <div class="mt-14 p-6 sm:p-8 rounded-2xl bg-white border border-zinc-200/90 shadow-sm">
          <div class="flex items-start space-x-4">
            <div class="w-12 h-12 rounded-xl bg-zinc-950 text-white flex items-center justify-center font-bold text-lg font-serif shrink-0 shadow-xs">
              {author.charAt(0)}
            </div>
            <div class="space-y-1.5 flex-1">
              <div class="flex items-baseline space-x-2">
                <h3 class="font-bold text-zinc-950 text-base">{author}</h3>
                <span class="text-xs text-amber-700 font-semibold uppercase tracking-wider">{authorRole}</span>
              </div>
              <p class="text-sm text-zinc-600 leading-relaxed">
                {isHi
                  ? 'हमारे स्वतंत्र उत्पाद एवं संस्कृति परीक्षण डेस्क द्वारा लिखित। हम अपने परीक्षण उत्पाद स्वयं खरीदते हैं, कॉर्पोरेट स्पॉन्सरशिप अस्वीकार करते हैं, और वास्तविक परिस्थितियों में परीक्षण करके तय करते हैं कि क्या सचमुच बेहतरीन है और क्या केवल मार्केटिंग का दिखावा।'
                  : 'Written by our independent product & cultural testing desk. We purchase our own subjects, reject corporate sponsorship, and test items under everyday conditions to filter true quality from marketing hype.'}
              </p>
            </div>
          </div>
        </div>

        <!-- Related Articles Section (Bottom of Post) -->
        {relatedPosts.length > 0 && (
          <div class="mt-16 pt-10 border-t border-zinc-200">
            <div class="flex items-center justify-between mb-6">
              <h3 class="font-serif text-2xl font-bold text-zinc-950">
                {isHi ? 'संबंधित समीक्षाएं' : 'Related Investigations'}
              </h3>
              <span class="text-xs font-semibold uppercase tracking-wider text-amber-700 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200">
                {isHi ? 'श्रेणी:' : 'In'} {category}
              </span>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {relatedPosts.map((related) => {
                const relatedLink = related.data.lang === 'hi' 
                  ? `/hi/blog/${related.id.replace(/^hi\//, '')}` 
                  : `/blog/${related.id}`;
                return (
                  <a 
                    href={relatedLink} 
                    class="group block p-5 rounded-2xl border border-zinc-200/90 bg-white hover:border-amber-500 hover:shadow-md transition-all"
                  >
                    <div class="flex items-center justify-between text-xs text-zinc-500 mb-2">
                      <span class="font-semibold text-amber-700 uppercase tracking-wide">{related.data.category}</span>
                      <span class="font-mono bg-zinc-100 px-2 py-0.5 rounded text-zinc-700">{related.data.specialScore.toFixed(1)}/10</span>
                    </div>
                    <h4 class="font-serif text-base sm:text-lg font-bold text-zinc-950 group-hover:text-amber-600 transition-colors line-clamp-2 leading-snug">
                      {related.data.title}
                    </h4>
                    <p class="text-xs text-zinc-600 mt-2 line-clamp-2 leading-relaxed">
                      {related.data.description}
                    </p>
                    <div class="mt-3 text-xs font-bold text-amber-700 group-hover:translate-x-1 transition-transform flex items-center space-x-1">
                      <span>{isHi ? 'पूरा निष्कर्ष पढ़ें' : 'Read Verdict'}</span>
                      <span>&rarr;</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}

      </div>

      <!-- Right Column: Sticky Sidebar (Span 4) -->
      <aside class="lg:col-span-4 space-y-6 sticky top-20">
        
        <!-- Sidebar Widget 1: The Verdict Scorecard -->
        <div class="p-6 rounded-3xl bg-white border border-zinc-200/90 shadow-sm space-y-4">
          <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-zinc-500 font-mono">
              {isHi ? 'त्वरित स्कोरकार्ड' : 'Quick Scorecard'}
            </span>
            <span class={`px-2.5 py-0.5 rounded-full border text-[11px] font-bold uppercase tracking-wider ${verdictColor}`}>
              {specialVerdict}
            </span>
          </div>

          <div class="flex items-baseline space-x-2">
            <span class="font-serif text-5xl font-black text-zinc-950">{specialScore.toFixed(1)}</span>
            <span class="text-zinc-600 font-bold uppercase text-xs font-mono">
              {isHi ? '/ 10 स्पेशल इंडेक्स' : '/ 10 Special Index'}
            </span>
          </div>

          <p class="text-xs text-zinc-600 leading-relaxed border-t border-zinc-100 pt-3">
            {isHi 
              ? 'हमारी रेटिंग सामग्री की गुणवत्ता, मरम्मत की सुविधा और टिकाऊ उपयोगिता पर आधारित है।' 
              : 'Ratings strictly reflect material quality, repairability, value durability, and authenticity versus manufacturer hype.'}
          </p>
        </div>

        <!-- Sidebar Widget 2: Recent Articles -->
        {recentPosts.length > 0 && (
          <div class="p-6 rounded-3xl bg-white border border-zinc-200/90 shadow-sm space-y-4">
            <div class="flex items-center justify-between border-b border-zinc-100 pb-3">
              <h4 class="font-serif text-base font-bold text-zinc-950">
                {isHi ? 'हालिया समीक्षाएं' : 'Recent Investigations'}
              </h4>
              <span class="text-[10px] font-mono text-zinc-600 uppercase bg-zinc-100 px-2 py-0.5 rounded">
                {isHi ? 'नया' : 'Latest'}
              </span>
            </div>

            <ul class="space-y-3.5 divide-y divide-zinc-100 text-xs">
              {recentPosts.map((recent, idx) => {
                const recentLink = recent.data.lang === 'hi' 
                  ? `/hi/blog/${recent.id.replace(/^hi\//, '')}` 
                  : `/blog/${recent.id}`;
                return (
                  <li class={idx > 0 ? 'pt-3' : ''}>
                    <a href={recentLink} class="group block space-y-1">
                      <span class="text-[10px] font-bold text-amber-700 uppercase tracking-wide block">
                        {recent.data.category} &bull; {recent.data.specialScore.toFixed(1)}/10
                      </span>
                      <h5 class="font-serif text-sm font-semibold text-zinc-950 group-hover:text-amber-600 transition-colors leading-snug">
                        {recent.data.title}
                      </h5>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        )}

        <!-- Sidebar Widget 3: Categories & Editorial Pillars -->
        {categoriesWithCount.length > 0 && (
          <div class="p-6 rounded-3xl bg-white border border-zinc-200/90 shadow-sm space-y-4">
            <h4 class="font-serif text-base font-bold text-zinc-950 border-b border-zinc-100 pb-3">
              {isHi ? 'विषय के अनुसार खोजें' : 'Browse by Pillar'}
            </h4>
            <ul class="space-y-1.5 text-xs">
              {categoriesWithCount.map((cat) => (
                <li>
                  <a 
                    href={isHi ? '/hi#articles' : '/#articles'} 
                    class="flex items-center justify-between p-2.5 rounded-xl hover:bg-zinc-50 transition-colors text-zinc-700 font-medium"
                  >
                    <span>{cat.name}</span>
                    <span class="px-2 py-0.5 rounded-full bg-zinc-100 text-zinc-700 font-mono text-[11px] font-bold border border-zinc-200/60">
                      {cat.count}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Sidebar Widget 4: Sticky Skyscraper AdSense Placeholder (Zero-CLS) -->
        <AdSlot format="sidebar" label="Advertisement (Sticky Sidebar)" slotId="ISITSPECIAL_SIDEBAR_STICKY" />

      </aside>

    </div>

  </div>
</BaseLayout>
