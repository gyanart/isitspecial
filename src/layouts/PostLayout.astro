---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';

interface PostItem {
  id: string;
  data: {
    title: string;
    description: string;
    pubDate: Date;
    category: string;
    specialScore: number;
    specialVerdict: string;
    readingTime: string;
  };
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  heroImageAlt?: string;
  category: string;
  author: string;
  authorRole: string;
  specialScore: number;
  specialVerdict: string;
  readingTime: string;
  currentSlug?: string;
  relatedPosts?: PostItem[];
  recentPosts?: PostItem[];
  allPosts?: PostItem[];
}

const {
  title,
  description,
  pubDate,
  heroImage,
  heroImageAlt,
  category,
  author,
  authorRole,
  specialScore,
  specialVerdict,
  readingTime,
  relatedPosts = [],
  recentPosts = [],
  allPosts = [],
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(pubDate);

const verdictColor = 
  specialVerdict === 'Overhyped' ? 'bg-rose-100 text-rose-800 border-rose-200' :
  specialVerdict === 'True Gem' ? 'bg-emerald-100 text-emerald-800 border-emerald-200' :
  specialVerdict === 'Modern Masterpiece' ? 'bg-indigo-100 text-indigo-800 border-indigo-200' : 
  'bg-amber-100 text-amber-800 border-amber-200';

// Calculate Category Counts
const categoriesWithCount = ['Hype vs. Reality', 'Everyday Curiosities', 'Craft & Design'].map((cat) => {
  const count = allPosts.filter((p) => p.data.category === cat).length;
  return { name: cat, count };
});
---

<BaseLayout title={`${title} | Is It Special?`} description={description} type="article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Review",
      "headline": title,
      "description": description,
      "image": heroImage ? (heroImage.startsWith('http') ? heroImage : `https://www.isitspecial.com${heroImage}`) : undefined,
      "datePublished": pubDate.toISOString(),
      "author": {
        "@type": "Organization",
        "name": author,
        "url": "https://www.isitspecial.com/about"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Is It Special?",
        "url": "https://www.isitspecial.com"
      },
      "itemReviewed": {
        "@type": "Product",
        "name": title
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": specialScore,
        "bestRating": "10",
        "worstRating": "1"
      }
    })} />
  </Fragment>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    
    <!-- Header Meta & Title (Centered) -->
    <header class="max-w-3xl mx-auto text-center space-y-4 pb-10 border-b border-stone-200">
      <div class="flex items-center justify-center space-x-2 text-xs">
        <a href="/" class="text-stone-600 hover:text-stone-900 transition-colors uppercase tracking-wider font-semibold">Articles</a>
        <span class="text-stone-600">/</span>
        <span class="text-amber-800 uppercase tracking-wider font-semibold">{category}</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl font-extrabold text-stone-900 tracking-tight leading-[1.18]">
        {title}
      </h1>

      <p class="text-stone-600 text-lg sm:text-xl font-normal leading-relaxed max-w-2xl mx-auto">
        {description}
      </p>

      <!-- Author and Date Meta -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-3 text-xs text-stone-600">
        <div class="flex items-center space-x-2">
          <div class="w-7 h-7 rounded-full bg-amber-700 text-stone-50 flex items-center justify-center font-bold text-xs uppercase">
            {author.charAt(0)}
          </div>
          <span class="font-semibold text-stone-900">{author}</span>
          <span class="text-stone-600">({authorRole})</span>
        </div>
        <span class="text-stone-600">&bull;</span>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span class="text-stone-600">&bull;</span>
        <span>{readingTime}</span>
        <span class="text-stone-600">&bull;</span>
        <span class={`px-2.5 py-0.5 rounded-full border text-[11px] font-bold uppercase tracking-wider ${verdictColor}`}>
          Verdict: {specialVerdict} ({specialScore.toFixed(1)}/10)
        </span>
      </div>
    </header>

    {heroImage && (
      <div class="max-w-4xl mx-auto my-8 overflow-hidden rounded-3xl border border-stone-200 bg-stone-100 shadow-xs">
        <img 
          src={heroImage} 
          alt={heroImageAlt || title} 
          class="w-full h-[260px] sm:h-[420px] object-cover" 
          loading="eager"
        />
      </div>
    )}

    <!-- Top In-Content Ad Placeholder (Zero-CLS) -->
    <div class="max-w-4xl mx-auto mt-6">
      <AdSlot format="horizontal" label="Advertisement (Top Leaderboard)" slotId="ISITSPECIAL_TOP_BANNER" />
    </div>

    <!-- Main Content & Sidebar Grid (Desktop 8 / 4 Grid) -->
    <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: The Editorial Article (Span 8) -->
      <div class="lg:col-span-8 min-w-0">
        <div class="prose prose-stone prose-lg max-w-none 
          prose-headings:font-serif prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-stone-900
          prose-p:leading-relaxed prose-p:text-stone-800
          prose-blockquote:border-l-4 prose-blockquote:border-amber-600 prose-blockquote:bg-amber-50/50 prose-blockquote:py-2 prose-blockquote:px-5 prose-blockquote:rounded-r-lg prose-blockquote:not-italic prose-blockquote:font-serif
          prose-strong:text-stone-900 prose-strong:font-bold
          prose-a:text-amber-800 prose-a:underline hover:prose-a:text-amber-900">
          <slot />
        </div>

        <!-- Mid-Article In-Content Ad Placeholder (Zero-CLS) -->
        <AdSlot format="horizontal" label="Advertisement (Mid-Article Flow)" slotId="ISITSPECIAL_MID_BANNER" />

        <!-- E-E-A-T Author Box (Required for Google Quality Raters & AdSense) -->
        <div class="mt-14 p-6 sm:p-8 rounded-2xl bg-stone-100 border border-stone-200">
          <div class="flex items-start space-x-4">
            <div class="w-12 h-12 rounded-full bg-amber-700 text-stone-50 flex items-center justify-center font-bold text-lg font-serif shrink-0">
              {author.charAt(0)}
            </div>
            <div class="space-y-1.5 flex-1">
              <div class="flex items-baseline space-x-2">
                <h3 class="font-bold text-stone-900 text-base">{author}</h3>
                <span class="text-xs text-amber-800 font-medium uppercase tracking-wider">{authorRole}</span>
              </div>
              <p class="text-sm text-stone-600 leading-relaxed">
                Written by our independent product & cultural testing desk. We purchase our own subjects, reject corporate sponsorship, and test items under everyday conditions to filter true quality from marketing hype.
              </p>
            </div>
          </div>
        </div>

        <!-- Related Articles Section (Bottom of Post) -->
        {relatedPosts.length > 0 && (
          <div class="mt-16 pt-10 border-t border-stone-200">
            <div class="flex items-center justify-between mb-6">
              <h3 class="font-serif text-2xl font-bold text-stone-900">Related Investigations</h3>
              <span class="text-xs font-semibold uppercase tracking-wider text-amber-800">In {category}</span>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {relatedPosts.map((related) => (
                <a 
                  href={`/blog/${related.id}`} 
                  class="group block p-5 rounded-2xl border border-stone-200 bg-white hover:border-amber-400 hover:shadow-sm transition-all"
                >
                  <div class="flex items-center justify-between text-xs text-stone-600 mb-2">
                    <span class="font-semibold text-amber-800 uppercase tracking-wide">{related.data.category}</span>
                    <span class="font-mono">{related.data.specialScore.toFixed(1)}/10</span>
                  </div>
                  <h4 class="font-serif text-base sm:text-lg font-bold text-stone-900 group-hover:text-amber-800 transition-colors line-clamp-2 leading-snug">
                    {related.data.title}
                  </h4>
                  <p class="text-xs text-stone-600 mt-2 line-clamp-2 leading-relaxed">
                    {related.data.description}
                  </p>
                  <div class="mt-3 text-xs font-semibold text-amber-800 group-hover:underline flex items-center space-x-1">
                    <span>Read Verdict</span>
                    <span>&rarr;</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Right Column: Sticky Sidebar (Span 4) -->
      <aside class="lg:col-span-4 space-y-8 sticky top-20">
        
        <!-- Sidebar Widget 1: The Verdict Scorecard -->
        <div class="p-6 rounded-2xl bg-white border border-stone-200 shadow-xs space-y-4">
          <div class="flex items-center justify-between border-b border-stone-100 pb-3">
            <span class="text-xs font-bold uppercase tracking-wider text-stone-600">Quick Scorecard</span>
            <span class={`px-2 py-0.5 rounded-full border text-[11px] font-bold uppercase tracking-wider ${verdictColor}`}>
              {specialVerdict}
            </span>
          </div>

          <div class="flex items-baseline space-x-2">
            <span class="font-serif text-5xl font-black text-stone-900">{specialScore.toFixed(1)}</span>
            <span class="text-stone-600 font-bold uppercase text-xs">/ 10 Special Index</span>
          </div>

          <p class="text-xs text-stone-600 leading-relaxed border-t border-stone-100 pt-3">
            Ratings strictly reflect material quality, repairability, value durability, and authenticity versus manufacturer hype.
          </p>
        </div>

        <!-- Sidebar Widget 2: Recent Articles -->
        {recentPosts.length > 0 && (
          <div class="p-6 rounded-2xl bg-white border border-stone-200 shadow-xs space-y-4">
            <div class="flex items-center justify-between border-b border-stone-100 pb-3">
              <h4 class="font-serif text-base font-bold text-stone-900">Recent Investigations</h4>
              <span class="text-[10px] font-mono text-stone-600 uppercase">New Drops</span>
            </div>

            <ul class="space-y-4 divide-y divide-stone-100 text-xs">
              {recentPosts.map((recent, idx) => (
                <li class={idx > 0 ? 'pt-3' : ''}>
                  <a href={`/blog/${recent.id}`} class="group block space-y-1">
                    <span class="text-[10px] font-bold text-amber-800 uppercase tracking-wide block">
                      {recent.data.category} &bull; {recent.data.specialScore.toFixed(1)}/10
                    </span>
                    <h5 class="font-serif text-sm font-semibold text-stone-900 group-hover:text-amber-800 transition-colors leading-snug">
                      {recent.data.title}
                    </h5>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Sidebar Widget 3: Categories & Editorial Pillars -->
        <div class="p-6 rounded-2xl bg-white border border-stone-200 shadow-xs space-y-4">
          <h4 class="font-serif text-base font-bold text-stone-900 border-b border-stone-100 pb-3">
            Browse by Pillar
          </h4>
          <ul class="space-y-2 text-xs">
            {categoriesWithCount.map((cat) => (
              <li>
                <a 
                  href="/#articles" 
                  class="flex items-center justify-between p-2 rounded-lg hover:bg-stone-50 transition-colors text-stone-700 font-medium"
                >
                  <span>{cat.name}</span>
                  <span class="px-2 py-0.5 rounded-full bg-stone-100 text-stone-600 font-mono text-[11px] font-bold">
                    {cat.count}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Sidebar Widget 4: Sticky Skyscraper AdSense Placeholder (Zero-CLS) -->
        <AdSlot format="sidebar" label="Advertisement (Sticky Sidebar)" slotId="ISITSPECIAL_SIDEBAR_STICKY" />

      </aside>

    </div>

  </div>
</BaseLayout>
