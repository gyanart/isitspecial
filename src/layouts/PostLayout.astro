---
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  author: string;
  authorRole: string;
  specialScore: number;
  specialVerdict: string;
  readingTime: string;
}

const {
  title,
  description,
  pubDate,
  category,
  author,
  authorRole,
  specialScore,
  specialVerdict,
  readingTime,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(pubDate);

const verdictColor = 
  specialVerdict === 'Overhyped' ? 'bg-rose-100 text-rose-800 border-rose-200' :
  specialVerdict === 'True Gem' ? 'bg-emerald-100 text-emerald-800 border-emerald-200' :
  specialVerdict === 'Modern Masterpiece' ? 'bg-indigo-100 text-indigo-800 border-indigo-200' : 
  'bg-amber-100 text-amber-800 border-amber-200';
---

<BaseLayout title={`${title} | Is It Special?`} description={description} type="article">
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
    
    <!-- Header Meta & Title -->
    <header class="max-w-2xl mx-auto text-center space-y-4 pb-10 border-b border-stone-200">
      <div class="flex items-center justify-center space-x-2 text-xs">
        <a href="/" class="text-stone-600 hover:text-stone-900 transition-colors uppercase tracking-wider font-semibold">Articles</a>
        <span class="text-stone-600">/</span>
        <span class="text-amber-800 uppercase tracking-wider font-semibold">{category}</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl font-extrabold text-stone-900 tracking-tight leading-[1.15]">
        {title}
      </h1>

      <p class="text-stone-600 text-lg sm:text-xl font-normal leading-relaxed">
        {description}
      </p>

      <!-- Author and Date Meta -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-3 text-xs text-stone-600">
        <div class="flex items-center space-x-2">
          <div class="w-7 h-7 rounded-full bg-stone-300 flex items-center justify-center font-bold text-stone-700 text-xs uppercase">
            {author.charAt(0)}
          </div>
          <span class="font-semibold text-stone-900">{author}</span>
          <span class="text-stone-600">({authorRole})</span>
        </div>
        <span class="text-stone-600">&bull;</span>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span class="text-stone-600">&bull;</span>
        <span>{readingTime}</span>
        <span class="text-stone-600">&bull;</span>
        <span class={`px-2 py-0.5 rounded-full border text-[11px] font-bold uppercase tracking-wider ${verdictColor}`}>
          Verdict: {specialVerdict} ({specialScore.toFixed(1)}/10)
        </span>
      </div>
    </header>

    <!-- Top In-Content Ad Placeholder (Zero-CLS) -->
    <div class="max-w-2xl mx-auto">
      <AdSlot format="horizontal" label="Advertisement (Top Story Slot)" slotId="ISITSPECIAL_TOP_BANNER" />
    </div>

    <!-- Main Editorial Reading Body -->
    <div class="max-w-2xl mx-auto pt-6">
      <div class="prose prose-stone prose-lg max-w-none 
        prose-headings:font-serif prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-stone-900
        prose-p:leading-relaxed prose-p:text-stone-800
        prose-blockquote:border-l-4 prose-blockquote:border-amber-600 prose-blockquote:bg-amber-50/50 prose-blockquote:py-2 prose-blockquote:px-5 prose-blockquote:rounded-r-lg prose-blockquote:not-italic prose-blockquote:font-serif
        prose-strong:text-stone-900 prose-strong:font-bold
        prose-a:text-amber-800 prose-a:underline hover:prose-a:text-amber-900">
        <slot />
      </div>

      <!-- Mid-Article In-Content Ad Placeholder (Zero-CLS) -->
      <AdSlot format="horizontal" label="Advertisement (Mid-Story Slot)" slotId="ISITSPECIAL_MID_BANNER" />

      <!-- E-E-A-T Author Box (Required for Google Quality Raters & AdSense) -->
      <div class="mt-16 p-6 sm:p-8 rounded-2xl bg-stone-100 border border-stone-200">
        <div class="flex items-start space-x-4">
          <div class="w-12 h-12 rounded-full bg-amber-700 text-stone-50 flex items-center justify-center font-bold text-lg font-serif">
            {author.charAt(0)}
          </div>
          <div class="space-y-1.5 flex-1">
            <div class="flex items-baseline space-x-2">
              <h3 class="font-bold text-stone-900 text-base">{author}</h3>
              <span class="text-xs text-amber-800 font-medium uppercase tracking-wider">{authorRole}</span>
            </div>
            <p class="text-sm text-stone-600 leading-relaxed">
              Written by our independent product & culture testing desk. We purchase our own test subjects, reject commercial sponsorships, and test things in everyday reality to filter true quality from marketing illusions.
            </p>
          </div>
        </div>
      </div>

    </div>
  </article>
</BaseLayout>
