---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  lang?: 'en' | 'hi';
  translationUrl?: string;
}

const {
  title = 'Is It Special? | The Filter Against Viral Hype & Consumer Illusions',
  description = 'In-depth, unvarnished critiques of viral products, everyday marvels, and cultural trends. We answer whether something is genuinely special or pure marketing.',
  image = '/og-default.jpg',
  canonicalUrl = Astro.url.href,
  type = 'website',
  lang = 'en',
  translationUrl,
} = Astro.props;

const siteName = lang === 'hi' ? 'इज इट स्पेशल? (Is It Special?)' : 'Is It Special?';
const siteUrl = 'https://www.isitspecial.com';

// Ensure fully qualified absolute URLs for canonical, translation, and OpenGraph (Required by GSC & GEO crawlers)
const fullCanonicalUrl = canonicalUrl.startsWith('http') ? canonicalUrl : `${siteUrl}${canonicalUrl.startsWith('/') ? '' : '/'}${canonicalUrl}`;
const fullTranslationUrl = translationUrl 
  ? (translationUrl.startsWith('http') ? translationUrl : `${siteUrl}${translationUrl.startsWith('/') ? '' : '/'}${translationUrl}`)
  : undefined;

// Environment variable support for GA4 & Google Search Console
const gaMeasurementId = import.meta.env.PUBLIC_GA_ID || 'G-DRJNNKLC7X';
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION || undefined;

const fullImageUrl = image.startsWith('http') ? image : `https://www.isitspecial.com${image.startsWith('/') ? '' : '/'}${image}`;
---

<!doctype html>
<html lang={lang} class="h-full bg-[#f7faf7] text-[#14241c] antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={fullCanonicalUrl} />

    <!-- RSS Auto-Discovery Feed -->
    <link rel="alternate" type="application/rss+xml" title="Is It Special? RSS Feed" href="https://www.isitspecial.com/rss.xml" />

    <!-- Google Search Console Verification Meta Tag -->
    {gscVerification && (
      <meta name="google-site-verification" content={gscVerification} />
    )}

    <!-- Google Analytics 4 (GA4) -->
    {gaMeasurementId && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
      <script is:inline define:vars={{ gaMeasurementId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaMeasurementId);
      </script>
    )}

    <!-- International Hreflang Tags (Fully Qualified Absolute URLs + x-default) -->
    {fullTranslationUrl && (
      <link rel="alternate" hreflang={lang === 'en' ? 'hi' : 'en'} href={fullTranslationUrl} />
    )}
    <link rel="alternate" hreflang={lang} href={fullCanonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={lang === 'en' ? fullCanonicalUrl : (fullTranslationUrl || fullCanonicalUrl)} />

    <!-- Google Fonts: Bitter (Display Serif) + Inter (Clean Sans) + Devanagari (Hindi) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700&family=Inter:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Noto+Serif+Devanagari:wght@400;600;700;800&display=swap" 
      rel="stylesheet" 
    />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={fullImageUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageUrl} />

    <!-- Global Schema.org JSON-LD (GEO / AI Citability / Knowledge Graph) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://www.isitspecial.com/#website",
          "url": "https://www.isitspecial.com/",
          "name": "Is It Special?",
          "description": "Unfiltered product teardowns, materials science analysis, and consumer criticism.",
          "inLanguage": ["en-US", "hi-IN"],
          "publisher": {
            "@id": "https://www.isitspecial.com/#organization"
          }
        },
        {
          "@type": "Organization",
          "@id": "https://www.isitspecial.com/#organization",
          "name": "Is It Special?",
          "url": "https://www.isitspecial.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://www.isitspecial.com/favicon.svg"
          },
          "sameAs": [
            "https://whatsapp.com/channel/0029VbE0Bs69Gv7SoqV89q04"
          ]
        }
      ]
    })} />

    <slot name="head" />
  </head>
  <body class="flex min-h-full flex-col font-sans selection:bg-amber-100 selection:text-amber-900 antialiased">
    <Header lang={lang} translationUrl={translationUrl} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
