---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  // English posts (not in hi/ directory)
  const enPosts = allPosts
    .filter((p) => (p.data.lang || 'en') === 'en' && !p.id.startsWith('hi/'))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return enPosts.map((post) => {
    // Check if Hindi translation exists
    const hasHiTranslation = allPosts.some(
      (p) => p.id === `hi/${post.id}` || p.data.translationSlug === post.id
    );
    const translationUrl = hasHiTranslation ? `/hi/blog/${post.id}` : undefined;

    const relatedPosts = enPosts
      .filter((p) => p.id !== post.id && p.data.category === post.data.category)
      .slice(0, 4);

    const recentPosts = enPosts
      .filter((p) => p.id !== post.id)
      .slice(0, 4);

    return {
      params: { slug: post.id },
      props: { 
        post, 
        translationUrl, 
        relatedPosts, 
        recentPosts, 
        allPosts: enPosts 
      },
    };
  });
}

const { post, translationUrl, relatedPosts, recentPosts, allPosts } = Astro.props;
const { Content } = await render(post);
---

<PostLayout 
  {...post.data} 
  currentSlug={post.id}
  lang="en"
  translationUrl={translationUrl}
  relatedPosts={relatedPosts}
  recentPosts={recentPosts}
  allPosts={allPosts}
>
  <Content />
</PostLayout>
