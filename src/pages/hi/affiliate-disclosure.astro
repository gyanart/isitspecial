---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ObfuscatedEmail from '../../components/ObfuscatedEmail.astro';
---

<BaseLayout 
  title="एफिलिएट प्रकटीकरण एवं पारदर्शिता नीति (Affiliate Disclosure) | इज़ इट स्पेशल?"
  description="इज़ इट स्पेशल? (Is It Special?) का पूर्ण एफिलिएट प्रकटीकरण एवं अमेज़न एसोसिएट्स अनुपालन विवरण।"
  lang="hi"
  translationUrl="/affiliate-disclosure"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-20 font-hindi">
    <header class="space-y-3 pb-8 border-b border-[#dce5dd]/80 text-center sm:text-left">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-[#15803d] bg-[#eaf5eb] border border-[#bbf7d0]">
        <span>⚖️</span>
        <span>पारदर्शिता एवं अनुपालन</span>
      </div>
      <h1 class="font-serif text-3xl sm:text-5xl font-black text-[#14241c] tracking-tight leading-tight">
        एफिलिएट प्रकटीकरण एवं निष्पक्षता नीति
      </h1>
      <p class="text-xs text-[#14241c]/60">
        अंतिम अद्यतन: अक्टूबर 2026 • 100% स्वतंत्र समीक्षा नीति
      </p>
    </header>

    <div class="prose prose-stone prose-base sm:prose-lg max-w-none pt-8
      prose-headings:font-serif prose-headings:font-bold prose-headings:text-[#14241c]
      prose-p:leading-relaxed prose-p:text-[#14241c]/80 prose-li:text-[#14241c]/80">
      
      <div class="p-5 rounded-2xl bg-[#eaf5eb] border border-[#bbf7d0] text-[#14241c] font-medium text-sm leading-relaxed mb-8">
        <strong>आधिकारिक अमेज़न एसोसिएट्स वक्तव्य:</strong><br />
        <em>"एक अमेज़न एसोसिएट (Amazon Associate) के रूप में, इज़ इट स्पेशल? (isitspecial.com) योग्य खरीदारियों से रेफरल कमीशन अर्जित करता है।"</em>
      </div>

      <h2>1. संपादकीय स्वतंत्रता का हमारा संकल्प</h2>
      <p>
        <strong>इज़ इट स्पेशल?</strong> (isitspecial.com) का एकमात्र उद्देश्य भ्रामक विज्ञापनों और इंटरनेट पर चल रहे झूठे प्रचार के खिलाफ भारतीय उपभोक्ताओं को एक निष्पक्ष, वैज्ञानिक और सच बोलने वाला मंच प्रदान करना है।
      </p>
      <p>
        अपनी समीक्षाओं में 100% ईमानदारी बनाए रखने के लिए हमारी संपादकीय टीम किसी भी व्यावसायिक दबाव से पूरी तरह मुक्त काम करती है:
      </p>
      <ul>
        <li><strong>कोई प्रायोजित (Sponsored) समीक्षा नहीं:</strong> हम किसी भी कंपनी से पैसे लेकर या मुफ्त उत्पाद प्राप्त करके उनकी प्रशंसा में समीक्षा नहीं लिखते।</li>
        <li><strong>पैसे देकर रेटिंग नहीं बदल सकती:</strong> कोई भी ब्रांड पैसे देकर अपने 'ओवरहाइप्ड' उत्पाद को 'मास्टरपीस' नहीं बनवा सकता।</li>
        <li><strong>स्वयं की खरीद:</strong> जहां तक संभव होता है, हमारे समीक्षक आम खरीदारों की तरह स्वयं उत्पाद खरीदकर उनका परीक्षण करते हैं।</li>
      </ul>

      <h2>2. एफिलिएट लिंक क्या होते हैं?</h2>
      <p>
        हमारी वेबसाइट पर दिए गए कुछ उत्पाद लिंक 'एफिलिएट लिंक' (Affiliate Links) होते हैं। जब आप इन लिंक्स पर क्लिक करके अमेज़न जैसी वेबसाइट से कुछ खरीदते हैं, तो विक्रेता मंच हमें बिक्री का एक छोटा सा हिस्सा रेफरल कमीशन के रूप में देता है।
      </p>
      <p>
        <strong>इस कमीशन से आपकी जेब पर एक पैसे का भी अतिरिक्त बोझ नहीं पड़ता।</strong> उत्पाद की कीमत आपके लिए वही रहती है जो सामान्य रूप से होती है।
      </p>

      <h2>3. प्रश्नों एवं सुझावों के लिए</h2>
      <p>
        यदि हमारी एफिलिएट नीति या उत्पाद समीक्षाओं के संबंध में आपका कोई प्रश्न है, तो आप हमारी संपादकीय टीम से सीधे <ObfuscatedEmail user="editorial" domain="isitspecial.com" /> पर संपर्क कर सकते हैं।
      </p>
    </div>
  </div>
</BaseLayout>
