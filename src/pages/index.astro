---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSlot from '../components/AdSlot.astro';

// Fetch English blog posts sorted by pubDate descending
const posts = (await getCollection('blog'))
  .filter(p => (p.data.lang || 'en') === 'en' && !p.id.startsWith('hi/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = posts.find(p => p.data.featured) || posts[0];
const regularPosts = posts.filter(p => p.id !== featuredPost?.id);
---

<BaseLayout lang="en" translationUrl="/hi">
  <!-- Hero Editorial Header -->
  <section class="border-b border-stone-200 bg-stone-100/60 py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-6">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest text-amber-800 bg-amber-100/70 border border-amber-200/80">
        Independent Cultural & Product Criticism
      </span>

      <h1 class="font-serif text-4xl sm:text-6xl font-black text-stone-900 tracking-tight leading-[1.1]">
        Is It Actually Special? <br />
        <span class="italic font-normal text-stone-600 font-serif">Or Just Marketing?</span>
      </h1>

      <p class="max-w-2xl mx-auto text-stone-600 text-lg sm:text-xl leading-relaxed">
        We test viral claims, examine everyday engineering marvels, and tear down commercial hype. No corporate sponsors. Just an honest 1-to-10 verdict.
      </p>

      <div class="pt-2 flex flex-wrap justify-center gap-3 text-xs font-semibold">
        <a href="#articles" class="px-5 py-2.5 rounded-full bg-stone-900 text-stone-50 hover:bg-stone-800 transition-colors shadow-sm">
          Browse Investigations
        </a>
        <a href="/about" class="px-5 py-2.5 rounded-full bg-white text-stone-800 border border-stone-300 hover:bg-stone-50 transition-colors">
          Our Testing Criteria
        </a>
      </div>
    </div>
  </section>

  <!-- Main Content Area -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    
    <!-- Top Ad Placeholder (Zero-CLS) -->
    <AdSlot format="horizontal" label="Advertisement (Leaderboard Slot)" slotId="ISITSPECIAL_HOME_LEADERBOARD" />

    <!-- Featured Post Spotlight (if exists) -->
    {featuredPost && (
      <section class="my-10 p-6 sm:p-8 rounded-3xl bg-white border border-stone-200 shadow-xs relative group">
        <div class="flex items-center space-x-2 text-xs font-bold uppercase tracking-wider text-amber-800 mb-2">
          <span>★ Featured Investigation</span>
          <span>&bull;</span>
          <span class="text-stone-600 font-mono">Special Index: {featuredPost.data.specialScore.toFixed(1)}/10</span>
        </div>

        <h2 class="font-serif text-2xl sm:text-4xl font-extrabold text-stone-900 group-hover:text-amber-800 transition-colors leading-tight">
          <a href={`/blog/${featuredPost.id}`}>
            <span class="absolute inset-0 z-10"></span>
            {featuredPost.data.title}
          </a>
        </h2>

        {featuredPost.data.heroImage && (
          <div class="my-5 overflow-hidden rounded-2xl border border-stone-200 bg-stone-100 max-h-72">
            <img src={featuredPost.data.heroImage} alt={featuredPost.data.title} class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300" />
          </div>
        )}

        <p class="mt-4 text-stone-600 text-base sm:text-lg leading-relaxed">
          {featuredPost.data.description}
        </p>

        <div class="mt-6 flex items-center justify-between pt-4 border-t border-stone-100 text-xs text-stone-600">
          <div class="flex items-center space-x-2">
            <span class="font-semibold text-stone-900">{featuredPost.data.author}</span>
            <span>&bull;</span>
            <span>{featuredPost.data.readingTime}</span>
          </div>
          <span class="font-bold text-amber-800 group-hover:underline">Read Full Verdict &rarr;</span>
        </div>
      </section>
    )}

    <!-- Article Feed Header -->
    <div id="articles" class="pt-8 pb-4 flex items-center justify-between border-b border-stone-200">
      <h3 class="font-serif text-2xl font-bold text-stone-900">Latest Editorial Dissections</h3>
      <span class="text-xs text-stone-600 font-mono">{posts.length} articles published</span>
    </div>

    <!-- Regular Articles List -->
    <div class="divide-y divide-stone-200">
      {regularPosts.map((post) => (
        <ArticleCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={post.id}
          category={post.data.category}
          specialScore={post.data.specialScore}
          specialVerdict={post.data.specialVerdict}
          readingTime={post.data.readingTime}
          heroImage={post.data.heroImage}
        />
      ))}
    </div>

    <!-- Mid-Feed Ad Unit (Zero-CLS) -->
    <div class="mt-12">
      <AdSlot format="horizontal" label="Advertisement (Feed Slot)" slotId="ISITSPECIAL_HOME_FEED" />
    </div>

    <!-- The Special Pledge / Mission Callout -->
    <section class="mt-16 p-8 rounded-3xl bg-stone-900 text-stone-100 space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-400">The Editorial Code</span>
      <h3 class="font-serif text-2xl sm:text-3xl font-bold">Never Sponsored. Never Sponsored Content.</h3>
      <p class="text-stone-300 text-sm sm:text-base leading-relaxed max-w-2xl">
        Every product, gadget, or tool evaluated on isitspecial.com is tested under real-world conditions. We do not accept money from brands to manipulate our "Special Index" scores. When something is overhyped, we say it clearly.
      </p>
      <div class="pt-2">
        <a href="/about" class="text-xs font-bold text-amber-400 hover:text-amber-300 underline underline-offset-4">
          Read our testing manifesto & methodology &rarr;
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
